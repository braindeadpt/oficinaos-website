---
import "../styles/global.css";
import type { Copy } from "../i18n/pt";
import {
  currentPagePath,
  DEFAULT_LOCALE,
  localeUrl,
  LOCALES,
} from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  t: Copy;
  locale: Locale;
  langAttr: string;
  ogLocale: string;
  title?: string;
  description?: string;
  jsonLd?: object[];
  /** Pré-carrega a Manrope (títulos) — só nas páginas cujo LCP é um título grande. */
  preloadDisplayFont?: boolean;
}

const { t, locale, langAttr, ogLocale } = Astro.props;
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const localeMap: Record<Locale, string> = {
  pt: "pt-PT",
  en: "en",
  es: "es",
};

// Canonical/hreflang must point at THIS page in each locale, not the
// locale root — otherwise every subpage declares itself a duplicate of
// the homepage and can be de-indexed.
const pagePath = currentPagePath(Astro.url.pathname, locale);
const canonical = new URL(localeUrl(locale, pagePath), Astro.site);
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
// Versioned filename — X/Telegram/WhatsApp/Discord cache OG cards per image
// URL, so a renamed file forces a fresh scrape. og-cover.png stays as a
// fallback for old links.
const ogImage = new URL(
  `${import.meta.env.BASE_URL}og-cover-2026.png`,
  Astro.site
);
---

<!doctype html>
<html lang={langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Tema escolhido no botão do cabeçalho (Automático · Claro · Escuro); evita o «flash».
      try {
        var t = localStorage.getItem("oos-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script is:inline>
      // SO para os botões «Descarregar» (ver src/lib/download.ts): data-os no <html> antes do
      // primeiro paint (os rótulos trocam por CSS, sem layout shift) e, no clique, o href passa a
      // data-dl-<os>. Sem JS fica o href por omissão (/download/).
      (function () {
        var n = navigator, u = n.userAgent || "", p = (n.userAgentData && n.userAgentData.platform) || n.platform || "", o;
        if (/android|iphone|ipad|ipod/i.test(u) || (/mac/i.test(p) && n.maxTouchPoints > 1)) o = "mobile";
        else if (/win/i.test(p) || /windows/i.test(u)) o = "win";
        else if (/mac|linux|x11|cros/i.test(p + " " + u)) o = "desktop";
        else return;
        document.documentElement.setAttribute("data-os", o);
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest && e.target.closest("a[data-dl-" + o + "]");
          if (a) a.href = a.getAttribute("data-dl-" + o);
        }, true);
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F5F7FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/inter-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      Astro.props.preloadDisplayFont && (
        <link
          rel="preload"
          href={`${import.meta.env.BASE_URL}fonts/manrope-latin.woff2`}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={localeMap[l]}
          href={new URL(localeUrl(l, pagePath), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeUrl(DEFAULT_LOCALE, pagePath), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="OficinaOS" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    {
      Astro.props.jsonLd?.length ? (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": Astro.props.jsonLd })}
        />
      ) : null
    }
    {
      // Cloudflare Web Analytics — cookieless, no fingerprinting, no
      // personal data (fits the privacy-first brand; no banner needed).
      // Token comes from a build-time var, never committed to the repo.
      // Empty → no beacon (local dev, forks).
      import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: import.meta.env.PUBLIC_CF_BEACON_TOKEN,
          })}
        />
      )
    }
  </head>
  <body
    class="min-h-screen bg-bg font-sans text-text antialiased"
  >
    <slot />
    {/* Reveal: fallback para browsers sem animation-timeline (CSS nativo em foundations.css).
        Só esconde depois de o JS correr, e nunca o que já está no ecrã. */}
    <script is:inline type="module">
      const d=document.documentElement;if(!CSS.supports("animation-timeline: view()")&&matchMedia("(prefers-reduced-motion: no-preference)").matches&&"IntersectionObserver"in window){const els=document.querySelectorAll(".reveal"),h=innerHeight,io=new IntersectionObserver((es)=>{for(const e of es)if(e.isIntersecting){e.target.classList.add("is-in");io.unobserve(e.target)}},{threshold:.2,rootMargin:"0px 0px -10% 0px"});els.forEach((el)=>{if(el.getBoundingClientRect().top<h)el.classList.add("is-in");else io.observe(el)});d.classList.add("io-reveal")}
    </script>
  </body>
</html>
