---
import ModuleDoc from "../../../components/ModuleDoc.astro";
import { moduleDocJsonLd } from "../../../i18n/schema";
import Base from "../../../layouts/Base.astro";
import { lang, locale, ogLocale, t } from "../../../i18n/es";
---

<Base t={t} locale={locale} langAttr={lang} ogLocale={ogLocale} title={t.moduleDocs.invoicing.title + " — OficinaOS"} jsonLd={moduleDocJsonLd(t, locale, "invoicing", t.moduleDocs.invoicing.title)} description={t.moduleDocs.invoicing.subtitle}>
  <ModuleDoc t={t} locale={locale} page={t.moduleDocs.invoicing} />
</Base>
