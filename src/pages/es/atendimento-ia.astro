---
import ModulePage from "../../components/modules/ModulePage.astro";
import Base from "../../layouts/Base.astro";
import { lang, locale, ogLocale, t } from "../../i18n/es";
---

<Base t={t} locale={locale} langAttr={lang} ogLocale={ogLocale} title={t.modulePages.atendimento.metaTitle} description={t.modulePages.atendimento.metaDesc} preloadDisplayFont ogImage="og/atendimento-es.jpg">
  <ModulePage t={t} locale={locale} m={t.modulePages.atendimento} interest="atendimento" />
</Base>
