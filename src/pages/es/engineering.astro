---
import Engineering from "../../components/Engineering.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import { ENGINEERING } from "../../data/engineering";
import { lang, locale, ogLocale, t } from "../../i18n/es";
import Base from "../../layouts/Base.astro";

const eng = ENGINEERING[locale];
---

<Base
  t={t}
  locale={locale}
  langAttr={lang}
  ogLocale={ogLocale}
  title={eng.metaTitle}
  description={eng.metaDesc}
  preloadDisplayFont
>
  <Nav t={t} locale={locale} />
  <main id="main" tabindex="-1">
    <Engineering t={t} locale={locale} />
  </main>
  <Footer t={t} locale={locale} />
</Base>
