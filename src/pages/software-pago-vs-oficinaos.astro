---
import SeoPage from "../components/SeoPage.astro";
import Base from "../layouts/Base.astro";
import { lang, locale, ogLocale, seoPages, t } from "../i18n/pt";
import { contentPageJsonLd } from "../i18n/schema";

const page = seoPages.softwarePagoVsOficinaOS;
---

<Base
  t={t}
  locale={locale}
  langAttr={lang}
  ogLocale={ogLocale}
  title={page.metaTitle}
  description={page.metaDesc}
  pageLocales={["pt"]}
  jsonLd={contentPageJsonLd(t, locale, "software-pago-vs-oficinaos", page.metaTitle)}
>
  <SeoPage t={t} locale={locale} page={page} pageLocales={["pt"]} />
</Base>
