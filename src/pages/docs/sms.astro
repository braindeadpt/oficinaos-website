---
import ModuleDoc from "../../components/ModuleDoc.astro";
import { moduleDocJsonLd } from "../../i18n/schema";
import Base from "../../layouts/Base.astro";
import { lang, locale, ogLocale, t } from "../../i18n/pt";
---

<Base t={t} locale={locale} langAttr={lang} ogLocale={ogLocale} title={t.moduleDocs.sms.title + " — OficinaOS"} jsonLd={moduleDocJsonLd(t, locale, "sms", t.moduleDocs.sms.title)} description={t.moduleDocs.sms.subtitle}>
  <ModuleDoc t={t} locale={locale} page={t.moduleDocs.sms} />
</Base>
