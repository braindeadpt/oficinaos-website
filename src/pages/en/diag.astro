---
import DiagPage from "../../components/diag/DiagPage.astro";
import { diagJsonLd } from "../../i18n/schema";
import Base from "../../layouts/Base.astro";
import { lang, locale, ogLocale, t } from "../../i18n/en";
---

<Base t={t} locale={locale} langAttr={lang} ogLocale={ogLocale} title={t.diagPage.metaTitle} description={t.diagPage.metaDesc} jsonLd={diagJsonLd(t, "https://oficinaos.app/en/diag/")} preloadDisplayFont>
  <DiagPage t={t} locale={locale} />
</Base>
