---
import SeoPage from "../../components/SeoPage.astro";
import Base from "../../layouts/Base.astro";
import { lang, locale, ogLocale, seoPages, t } from "../../i18n/en";
import { contentPageJsonLd } from "../../i18n/schema";

const page = seoPages.deixarExcelPapel;
---

<Base
  t={t}
  locale={locale}
  langAttr={lang}
  ogLocale={ogLocale}
  title={page.metaTitle}
  description={page.metaDesc}
  jsonLd={contentPageJsonLd(t, locale, "deixar-excel-papel", page.metaTitle)}
>
  <SeoPage t={t} locale={locale} page={page} />
</Base>
