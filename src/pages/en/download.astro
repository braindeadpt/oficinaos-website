---
import DownloadPage from "../../components/DownloadPage.astro";
import Base from "../../layouts/Base.astro";
import { lang, locale, ogLocale, t } from "../../i18n/en";
import { downloadJsonLd } from "../../i18n/schema";
---

<Base
  t={t}
  locale={locale}
  langAttr={lang}
  ogLocale={ogLocale}
  title={t.download.metaTitle}
  description={t.download.metaDesc}
  jsonLd={downloadJsonLd(t)}
  preloadDisplayFont
>
  <DownloadPage t={t} locale={locale} />
</Base>
