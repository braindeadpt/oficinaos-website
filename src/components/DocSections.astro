---
// Corpo das páginas de documentação (fase 5): títulos com id estável e ligação (#), tabelas
// responsivas (ui/DataTable — 3+ colunas viram cartões em ecrãs estreitos), código em mono com
// botão «Copiar» (aparece só com JS e Clipboard API; o script vive em docs/DocsShell.astro).
import type { DocsSection } from "../i18n/pt";
import { normalizeHref, sectionIds } from "../lib/docs";
import Icon from "./Icon.astro";
import DataTable from "./ui/DataTable.astro";

interface Props {
  sections: DocsSection[];
  ui: { copy: string; copied: string; copyLabel: string };
}
const { sections, ui } = Astro.props;
const ids = sectionIds(sections);
const isExternal = (href: string) => !href.startsWith("#") && !href.startsWith("/");
---

<div class="space-y-14">
  {
    sections.map((s, i) => (
      <section id={ids[i]} class="doc-section">
        <h2 class="font-display text-xl font-bold leading-snug tracking-[-0.01em] text-text sm:text-[1.375rem]">
          <a href={`#${ids[i]}`} class="heading-link">
            {s.heading}
            <span class="heading-hash" aria-hidden="true">#</span>
          </a>
        </h2>
        {s.paragraphs.map((p) => (
          <p class="mt-4 text-pretty text-md text-text-muted">{p}</p>
        ))}
        {s.list && (
          <ul class="mt-4 space-y-2.5">
            {s.list.map((item) => (
              <li class="flex gap-3 text-base text-text-muted">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-product" aria-hidden="true" />
                <span class="min-w-0">{item}</span>
              </li>
            ))}
          </ul>
        )}
        {s.table && (
          <DataTable
            class="mt-4"
            caption={s.heading}
            label={s.heading}
            head={s.table.head}
            rows={s.table.rows}
            stack={s.table.head.length >= 3}
          />
        )}
        {s.code && (
          <div class="code-wrap relative mt-4">
            <pre
              class="code-block scroll-region rounded-lg border border-border bg-surface-2 p-4 pr-24 font-mono text-[13px] leading-relaxed text-text sm:p-5 sm:pr-24 sm:text-sm"
              role="region"
              aria-label={s.heading}
              tabindex="0"
            ><code>{s.code}</code></pre>
            <button
              type="button"
              class="copy-btn absolute top-2 right-2 inline-flex min-h-8 items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 text-xs font-semibold text-text-muted"
              data-copy
              data-copied={ui.copied}
              aria-label={`${ui.copyLabel} — ${s.heading}`}
              hidden
            >
              <Icon name="copy" class="h-3.5 w-3.5" />
              <span class="copy-txt">{ui.copy}</span>
            </button>
          </div>
        )}
        {s.images && s.images.length > 0 && (
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {s.images.map((img) => (
              <figure class="overflow-hidden rounded-lg border border-border bg-surface">
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" class="oos-photo w-full" />
                {img.caption && (
                  <figcaption class="px-4 py-2.5 text-xs text-text-muted">{img.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        )}
        {s.links && s.links.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {s.links.map((l) => (
              <a
                href={normalizeHref(l.href)}
                target={isExternal(l.href) ? "_blank" : undefined}
                rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
                class="inline-flex items-center gap-1.5 font-medium text-link underline-offset-4 transition hover:text-primary-hover hover:underline"
              >
                {l.label}
                {isExternal(l.href) && <Icon name="external" class="h-3.5 w-3.5" />}
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }
</div>
