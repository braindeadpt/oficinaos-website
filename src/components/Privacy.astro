---
import type { Copy } from "../i18n/pt";
import { REPO_URL } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

const icons = ["shield", "globe", "clipboard"] as const;
---

<section id="privacy" class="border-b border-zinc-800/60">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-teal-500/30 bg-teal-500/10 px-3 py-1 text-xs font-medium text-teal-300"
      >
        {t.privacy.badge}
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {t.privacy.title}
      </h2>
      <p class="mt-4 text-lg text-zinc-400">{t.privacy.subtitle}</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        t.privacy.cards.map((c, i) => (
          <div class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-500/10 text-teal-400">
              <Icon name={icons[i]} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 font-semibold text-white">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{c.desc}</p>
          </div>
        ))
      }
    </div>
    <div
      class="mt-12 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 sm:p-8"
    >
      <h3 class="font-semibold text-white">{t.privacy.tableTitle}</h3>
      <ul class="mt-4 divide-y divide-zinc-800/70">
        {
          t.privacy.table.map((row) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <span class="text-sm font-medium text-zinc-200">{row.name}</span>
              <span class="text-sm text-zinc-400">
                <span class="text-teal-400">{row.to}</span>
                {" — "}
                {row.what}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-zinc-500">
        <a
          href={`${REPO_URL}/blob/main/docs/privacy-and-data.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-teal-400 underline-offset-2 hover:underline"
        >
          {t.privacy.tableNote}
        </a>
      </p>
    </div>
  </div>
</section>
