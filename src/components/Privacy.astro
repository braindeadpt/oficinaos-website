---
import type { Copy } from "../i18n/pt";
import { CLOUD_PRIVACY_URL, REPO_URL } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

const icons = ["shield", "globe", "clipboard"] as const;
---

<section id="privacy" class="border-b border-border">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-primary-soft bg-primary-soft px-3 py-1 text-xs font-medium text-on-primary-soft"
      >
        {t.privacy.badge}
      </span>
      <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
        {t.privacy.title}
      </h2>
      <p class="mt-4 text-lg text-text-muted">{t.privacy.subtitle}</p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        t.privacy.cards.map((c, i) => (
          <div class="rounded-lg border border-border bg-surface shadow-sm p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-soft text-on-primary-soft">
              <Icon name={icons[i]} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-text">{c.title}</h3>
            <p class="mt-2 text-base text-text-muted">{c.desc}</p>
          </div>
        ))
      }
    </div>
    <div
      class="mt-12 rounded-lg border border-border bg-surface shadow-sm p-6 sm:p-8"
    >
      <h3 class="font-semibold text-text">{t.privacy.tableTitle}</h3>
      <ul class="mt-4 divide-y divide-border">
        {
          t.privacy.table.map((row) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <span class="text-sm font-medium text-text">{row.name}</span>
              <span class="text-sm text-text-muted">
                <span class="text-link">{row.to}</span>
                {" — "}
                {row.what}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs text-text-muted">
        <a
          href={CLOUD_PRIVACY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-link underline underline-offset-2 hover:text-primary-hover"
        >
          {t.privacy.cloudPrivacyLink}
        </a>
        <a
          href={`${REPO_URL}/blob/main/docs/privacy-and-data.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-link underline underline-offset-2 hover:text-primary-hover"
        >
          {t.privacy.tableNote}
        </a>
      </p>
    </div>
  </div>
</section>
