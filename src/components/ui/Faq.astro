---
// Perguntas frequentes com <details>/<summary> nativos: sem JS, teclado e leitores de ecrã de origem.
// <Faq id="faq" title="Perguntas frequentes" items={[{ q, a }]} />
import Section from "./Section.astro";
import Heading from "./Heading.astro";

interface Props {
  id?: string;
  title: string;
  items: { q: string; a: string }[];
  product?: "os" | "diag" | "pro" | "trade";
}
const { id = "faq", title, items, product } = Astro.props;
---

<Section id={id} width="narrow" product={product} labelledby={`${id}-title`}>
  <Heading id={`${id}-title`}>{title}</Heading>
  <div class="mt-8 divide-y divide-border border-y border-border">
    {
      items.map((it) => (
        <details class="faq group">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-left font-display text-lg font-bold tracking-[-0.01em] text-text">
            <span>{it.q}</span>
            <svg
              class="faq-icon mt-1 h-5 w-5 shrink-0 text-text-subtle"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14" class="faq-v" />
              <path d="M5 12h14" />
            </svg>
          </summary>
          <p class="max-w-prose pb-6 text-pretty text-base text-text-muted">{it.a}</p>
        </details>
      ))
    }
  </div>
</Section>
