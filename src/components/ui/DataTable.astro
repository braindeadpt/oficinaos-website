---
// Tabela de dados com scroll horizontal (scroll-x) em ecrãs estreitos. A primeira coluna pode ser
// cabeçalho de linha (th scope=row). Cabeçalho vazio → <td> (axe empty-table-header).
interface Props {
  caption: string;
  head: string[];
  rows: string[][];
  /** Rótulo da região com scroll (leitores de ecrã). */
  label: string;
  rowHeaders?: boolean;
  class?: string;
}
const { caption, head, rows, label, rowHeaders = true, class: cls } = Astro.props;
---

<div class:list={["scroll-x scroll-region rounded-lg border border-border", cls]} role="region" aria-label={label} tabindex="0">
  <table class="doc-table w-full text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-border bg-surface-2">
        {
          head.map((h) =>
            h.trim() ? (
              <th scope="col" class="px-4 py-2.5 text-left text-caption font-semibold uppercase tracking-[0.06em] text-text-muted">
                {h}
              </th>
            ) : (
              <td class="px-4 py-2.5" />
            )
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-border last:border-0">
            {row.map((cell, i) =>
              i === 0 && rowHeaders ? (
                <th scope="row" class="px-4 py-2.5 text-left leading-relaxed font-semibold text-text">
                  {cell}
                </th>
              ) : (
                <td class="px-4 py-2.5 leading-relaxed text-text-muted">{cell}</td>
              )
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
