---
// Janela da app (cromado tipo Windows) para alojar UI do produto recriada em HTML.
// Nítida a qualquer zoom, traduzível e indexável — nunca um PNG.
// <UiFrame title="Reparações" product="os" caption={t.ui.frame.caption}><RepairList … /></UiFrame>
import type { ProductId } from "../../lib/products";

interface Props {
  /** Texto da barra de título, a seguir ao nome da app. */
  title?: string;
  appName?: string;
  product?: ProductId;
  /** Descrição para leitores de ecrã (a UI é uma recriação com dados de exemplo). */
  caption: string;
  /** Classe de view transition (ex.: "vt-product-diag") para o morph entre páginas. */
  vt?: string;
  elevated?: boolean;
  class?: string;
}
const {
  title,
  appName = "OficinaOS",
  product = "os",
  caption,
  vt,
  elevated = true,
  class: cls,
} = Astro.props;
---

<figure
  data-product={product}
  class:list={[
    "ui-frame overflow-hidden rounded-2xl border border-border bg-surface text-left",
    elevated && "shadow-lg",
    vt,
    cls,
  ]}
>
  <div
    class="ui-frame-bar flex h-10 select-none items-center gap-3 px-3.5 text-xs text-text-muted"
    aria-hidden="true"
  >
    <span class="flex shrink-0 items-center gap-1.5">
      <span class="ui-frame-dot ui-frame-dot-close"></span>
      <span class="ui-frame-dot ui-frame-dot-min"></span>
      <span class="ui-frame-dot ui-frame-dot-max"></span>
    </span>
    <span class="mx-auto flex min-w-0 items-center gap-1.5 truncate pr-10">
      <span class="h-2 w-2 shrink-0 rounded-full bg-product"></span>
      <span class="font-semibold text-text">{appName}</span>
      {title && <span class="truncate text-text-muted">— {title}</span>}
    </span>
  </div>
  <div class="relative">
    <slot />
  </div>
  <figcaption class="sr-only">{caption}</figcaption>
</figure>
