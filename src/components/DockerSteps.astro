---
// Comandos Docker (Linux / macOS / servidor). Era o bloco «avançado» da home; vive agora em /download/.
import type { Copy } from "../i18n/pt";
import { REPO_URL } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-border bg-surface-2">
  <div class="flex items-center gap-2 border-b border-border bg-surface px-4 py-2.5 text-xs font-medium text-text-muted">
    <Icon name="terminal" class="h-3.5 w-3.5" />
    <span>Linux / macOS</span>
  </div>
  <pre
    tabindex="0"
    role="region"
    aria-label="Linux / macOS — Docker"
    class="code-block scroll-region p-4 font-mono text-[13px] leading-relaxed text-text sm:p-5"><code><span class="text-text-muted"># {t.install.advanced.commentGet}</span>
<span class="select-none text-primary">$</span> git clone {REPO_URL}.git
<span class="select-none text-primary">$</span> cd OficinaOS && cp .env.example .env

<span class="text-text-muted"># {t.install.advanced.commentStart}</span>
<span class="select-none text-primary">$</span> docker compose up -d
<span class="select-none text-primary">$</span> docker compose exec app bun run db:seed

<span class="text-text-muted"># {t.install.advanced.commentOpen}</span>
<span class="text-link">http://localhost:4000</span></code></pre>
</div>
<p class="mt-3 text-xs text-text-muted">{t.install.advanced.note}</p>
