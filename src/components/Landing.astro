---
// Página inicial (redesenho 2026-11, «Oficina limpa»): herói com fotografia e interface viva →
// corpo (para quem, como funciona, vídeo, produtos, Pro, dados, novidades, descarregar).
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { getLatestRelease } from "../lib/release";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import HomeBody from "./home/HomeBody.astro";
import HomeHero from "./home/HomeHero.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const release = await getLatestRelease();
---

<Nav t={t} locale={locale} />
<main id="main" tabindex="-1">
  <HomeHero t={t} locale={locale} release={release} />
  <HomeBody t={t} locale={locale} release={release} />
</main>
<Footer t={t} locale={locale} />
