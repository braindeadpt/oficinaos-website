---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import Install from "./Install.astro";
import Nav from "./Nav.astro";
import Pro from "./Pro.astro";
import Screenshots from "./Screenshots.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<Nav t={t} locale={locale} />
<main>
  <Hero t={t} />
  <Features t={t} />
  <Screenshots t={t} />
  <Pro t={t} />
  <Install t={t} />
</main>
<Footer t={t} />
