---
// Herói do Pro — palco de produto nítido (janela macOS Mensagens + iPhone 16 WhatsApp).
// Substitui a fotografia IA por UI vetorial/HTML limpa, cheia de ponta a ponta e sem frestas.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import Icon from "../Icon.astro";
import "../../styles/photo-hero.css";
import "../../styles/hero-stage.css";
import "../../styles/pro-stage.css";

interface Props {
  t: Copy;
  locale: Locale;
  priceLine: string;
  cta: string;
}
const { t, priceLine, cta } = Astro.props;
const h = t.proPage.hero;
const ph = t.proHero;
const shop = t.homeHero.shop;
const initials = (n: string) =>
  n
    .split(" ")
    .map((x) => x[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<section class="hh hh-pro" aria-labelledby="pro-hero-title" data-hh>
  <div class="hh-inner">
    <div class="hh-copy">
      <p class="hh-eyebrow"><span aria-hidden="true"></span>{h.label} · {t.pro.badge}</p>
      <h1 id="pro-hero-title" class="hh-title">
        <span>{ph.titleA}</span>
        <span class="hh-title-b">{ph.titleB}</span>
      </h1>
      <p class="hh-lead">{h.subtitle}</p>
      <div class="hh-ctas">
        <a href="#beta" class="hh-btn hh-btn-primary">
          {cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="#modules" class="hh-btn hh-btn-ghost">{h.ctaSecondary}</a>
      </div>
      <p class="hp-price">{priceLine}</p>
    </div>

    <figure class="hh-stage">
      <div class="pst-scene vt-product-pro" aria-hidden="true">
        <!-- Aviso flutuante: respondido com a loja fechada -->
        <div class="st-ios-notice">
          <span class="st-ios-ico">
            <svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
          </span>
          <span class="st-ios-text">
            <small>{ph.notice}</small>
            <b>{ph.noticeText}</b>
          </span>
        </div>

        <!-- Janela macOS Mensagens -->
        <div class="pst-mac">
          <div class="pst-bar">
            <span class="pst-bar-left">
              <span class="st-dots"><i></i><i></i><i></i></span>
              <b>{ph.inbox}</b>
            </span>
            <span class="pst-closed"><i></i>{ph.closed}</span>
          </div>
          <div class="pst-body">
            <ul class="pst-list" role="list">
              <li class="pst-item is-on">
                <span class="pst-ini">{initials(ph.customer)}</span>
                <span class="pst-item-txt">
                  <b>{ph.customer}</b>
                  <small>{ph.ask}</small>
                </span>
                <span class="pst-unread"></span>
              </li>
              {
                ph.others.map(([name, channel, last]) => (
                  <li class="pst-item">
                    <span class="pst-ini">{initials(name)}</span>
                    <span class="pst-item-txt">
                      <b>{name}</b>
                      <small>{channel} · {last}</small>
                    </span>
                  </li>
                ))
              }
            </ul>
            <div class="pst-thread">
              <p class="pst-thread-head">
                <b>{ph.customer}</b>
                <small>WhatsApp</small>
              </p>
              <div class="pst-msgs">
                <p class="pst-msg pst-msg-in pst-ask">{ph.ask}<small>{ph.time}</small></p>
                <p class="pst-typing"><i></i><i></i><i></i></p>
                <div class="pst-reply-wrap pst-reply">
                  <p class="pst-msg pst-msg-out">{ph.reply}<small>{ph.time} ✓✓</small></p>
                  <p class="pst-by">{ph.answered}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- iPhone 16 WhatsApp cheio de ponta a ponta -->
        <div class="st-iphone">
          <div class="pst-wa-screen">
            <div class="pst-wa-top">
              <div class="st-ios-status">
                <span>{ph.time}</span>
                <span class="st-island"></span>
                <span class="st-ios-sig"><i></i></span>
              </div>
              <div class="pst-wa-shop">
                <span class="st-pho-avatar">{initials(shop)}</span>
                <span>
                  <b>{shop}</b>
                  <small>WhatsApp</small>
                </span>
              </div>
            </div>
            <div class="pst-wa-feed">
              <p class="pst-wb pst-wb-out pst-ask">{ph.ask}</p>
              <p class="pst-typing"><i></i><i></i><i></i></p>
              <p class="pst-wb pst-wb-in pst-reply">{ph.reply}</p>
            </div>
            <div class="pst-wa-input">
              <span class="pst-wa-pill"></span>
              <span class="pst-wa-send"></span>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="hh-caption">{ph.caption}</figcaption>
    </figure>

    <!-- Conversa em texto para teclado e leitores de ecrã -->
    <details class="hp-more">
      <summary>{ph.readConversation}</summary>
      <div class="hp-more-body">
        <p class="hp-tr hp-tr-in"><small>{ph.customer} · {ph.time}</small>{ph.ask}</p>
        <p class="hp-tr hp-tr-out"><small>{ph.answered}</small>{ph.reply}</p>
      </div>
    </details>
  </div>
</section>

<script is:inline>
  (function () {
    var s = document.querySelector("[data-hh]");
    var target = s && s.querySelector(".pst-mac");
    if (!target || !("IntersectionObserver" in window)) return;
    var r = target.getBoundingClientRect();
    if (r.top >= 0 && r.bottom <= innerHeight) return;
    s.classList.add("hh-wait");
    var io = new IntersectionObserver(
      function (es) {
        if (es[0].intersectionRatio >= 0.45) {
          s.classList.remove("hh-wait");
          io.disconnect();
        }
      },
      { threshold: [0, 0.45, 1] },
    );
    io.observe(target);
  })();
</script>
