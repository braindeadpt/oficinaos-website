---
import type { Copy, DocPage } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { localeUrl } from "../i18n/utils";
import DocSections from "./DocSections.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
  t: Copy;
  locale: Locale;
  page: DocPage;
  /** Página de produto correspondente (ex.: /diag/ a partir de /docs/diag/). */
  productLink?: { href: string; label: string };
}
const { t, locale, page, productLink } = Astro.props;
---

<Nav t={t} locale={locale} />
<main id="main" tabindex="-1" class="mx-auto max-w-3xl px-6 py-16">
  <a
    href={localeUrl(locale, "/docs")}
    class="text-sm font-medium text-text-muted transition hover:text-primary-hover"
  >
    ← {t.docs.backToGuide}
  </a>
  <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
    {page.title}
  </h1>
  <p class="mt-4 text-lg text-text-muted">{page.subtitle}</p>
  {
    productLink && (
      <p class="mt-4">
        <a href={productLink.href} class="inline-flex items-center gap-1.5 font-semibold text-link underline underline-offset-4 hover:text-primary-hover">
          {productLink.label} <span aria-hidden="true">→</span>
        </a>
      </p>
    )
  }

  <div class="mt-12">
    <DocSections sections={page.sections} />
  </div>
</main>
<Footer t={t} locale={locale} />
