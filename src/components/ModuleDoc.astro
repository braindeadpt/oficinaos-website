---
// /docs/<módulo>/ — guia de um módulo, no layout da documentação (fase 5). O acento segue o
// produto (Diag ciano, módulos Pro âmbar, canal SMS do core azul) — ver DOC_MODULES.
import type { Copy, DocPage } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { DOC_MODULES } from "../lib/docs";
import DocsShell from "./docs/DocsShell.astro";

interface Props {
  t: Copy;
  locale: Locale;
  page: DocPage;
  /** Página de produto correspondente (ex.: /diag/ a partir de /docs/diag/). */
  productLink?: { href: string; label: string };
}
const { t, locale, page, productLink } = Astro.props;
const mod = DOC_MODULES.find((m) => t.moduleDocs[m.key] === page);
---

<DocsShell
  t={t}
  locale={locale}
  current={mod?.slug ?? ""}
  product={mod?.product ?? "os"}
  title={page.title}
  subtitle={page.subtitle}
  sections={page.sections}
  productLink={productLink}
/>
