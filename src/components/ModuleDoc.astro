---
import type { Copy, DocPage } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { localeUrl } from "../i18n/utils";
import DocSections from "./DocSections.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
  t: Copy;
  locale: Locale;
  page: DocPage;
}
const { t, locale, page } = Astro.props;
---

<Nav t={t} locale={locale} />
<main class="mx-auto max-w-3xl px-6 py-16">
  <a
    href={localeUrl(locale, "/docs")}
    class="text-sm font-medium text-text-muted transition hover:text-primary-hover"
  >
    ← {t.docs.backToGuide}
  </a>
  <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
    {page.title}
  </h1>
  <p class="mt-4 text-lg text-text-muted">{page.subtitle}</p>

  <div class="mt-12">
    <DocSections sections={page.sections} />
  </div>
</main>
<Footer t={t} locale={locale} />
