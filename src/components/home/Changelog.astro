---
// Novidades na home: as 4 entradas mais recentes de src/data/updates.ts (as mesmas de /updates/).
import { UPDATES, type UpdateTier } from "../../data/updates";
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import Heading from "../ui/Heading.astro";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const c = t.home.changelog;
const dateLocale = { pt: "pt-PT", en: "en-GB", es: "es-ES" }[locale];
const fmt = new Intl.DateTimeFormat(dateLocale, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const product: Record<UpdateTier, "os" | "pro" | "diag"> = { free: "os", pro: "pro", diag: "diag" };
const tierLabel: Record<UpdateTier, string> = { free: t.updates.free, pro: t.updates.pro, diag: "Diag" };
const latest = UPDATES.slice(0, 4);
---

<section id="novidades" aria-labelledby="changelog-title">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <div>
      <Heading id="changelog-title">
        {c.title}
        <Fragment slot="lead">{c.lead}</Fragment>
      </Heading>
      <a
        href={localeUrl(locale, "/updates/")}
        class="mt-6 inline-flex items-center gap-1.5 font-semibold text-link underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary-hover"
      >
        {c.all}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <ol class="reveal min-w-0 divide-y divide-border border-y border-border">
      {
        latest.map((u) => (
          <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[8rem_minmax(0,1fr)]">
            <p class="flex items-center gap-2 text-sm text-text-muted sm:flex-col sm:items-start">
              <time class="num" datetime={u.date}>{fmt.format(new Date(u.date))}</time>
              <span data-product={product[u.tier]} class="inline-flex items-center gap-1.5 text-xs font-semibold text-product">
                <span class="h-2 w-2 rounded-[2px] bg-product" aria-hidden="true" />
                {tierLabel[u.tier]} · {u.area[locale]}
              </span>
            </p>
            <div class="min-w-0">
              <h3 class="font-display text-md font-bold text-text">{u.title[locale]}</h3>
              <p class="mt-1 text-sm text-text-muted">{u.desc[locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
