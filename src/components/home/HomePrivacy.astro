---
// Dados e privacidade: onde vivem os dados (no seu PC) vs o que só sai se ligar.
// O detalhe módulo a módulo está em /privacy/.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import Heading from "../ui/Heading.astro";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const p = t.home.privacy;
---

<section id="dados" aria-labelledby="privacy-title" class="border-y border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <div class="min-w-0">
      <Heading id="privacy-title">
        {p.title}
        <Fragment slot="lead">{p.lead}</Fragment>
      </Heading>
      <dl class="mt-8 space-y-5">
        {
          p.points.map(([term, desc]) => (
            <div class="border-l-2 border-primary pl-4">
              <dt class="font-semibold text-text">{term}</dt>
              <dd class="mt-1 text-text-muted">{desc}</dd>
            </div>
          ))
        }
      </dl>
      <a
        href={localeUrl(locale, "/privacy/")}
        class="mt-8 inline-flex items-center gap-1.5 font-semibold text-link underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary-hover"
      >
        {p.link}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="reveal min-w-0 self-center">
      <div class="rounded-xl border-2 border-primary bg-bg p-5 sm:p-6">
        <p class="flex items-center gap-2 font-display text-lg font-bold text-text">
          <svg class="h-5 w-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
          {p.localTitle}
        </p>
        <ul role="list" class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            p.local.map((item) => (
              <li class="flex items-center gap-2 rounded-md bg-surface px-3 py-2 text-sm text-text">
                <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mx-auto h-8 w-px border-l-2 border-dashed border-border-strong" aria-hidden="true"></div>
      <div class="rounded-xl border-2 border-dashed border-border-strong p-5 sm:p-6">
        <p class="flex items-center gap-2 font-display text-lg font-bold text-text">
          <svg class="h-5 w-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18.36 6.64A9 9 0 1 1 5.64 6.64" /><path d="M12 2v10" /></svg>
          {p.optionalTitle}
        </p>
        <ul role="list" class="mt-4 grid gap-2 sm:grid-cols-2">
          {p.optional.map((item) => <li class="rounded-md border border-border px-3 py-2 text-sm text-text-muted">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
