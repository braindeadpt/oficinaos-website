---
// Herói da página inicial — palco de produto nítido (Mercury + Linear + Apple macOS/iOS).
// Janela macOS OficinaOS com ícones reais + iPhone 16 sobreposto cheio de ponta a ponta +
// notificação iOS em Liquid Glass, tudo sincronizado com o dock interativo (Receção / Em reparação / Pronto).
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import { downloadAttrs } from "../../lib/download";
import type { ReleaseInfo } from "../../lib/release";
import Icon from "../Icon.astro";
import "../../styles/photo-hero.css";
import "../../styles/hero-interactive.css";
import "../../styles/hero-stage.css";

interface Props {
  t: Copy;
  locale: Locale;
  release: ReleaseInfo | null;
}
const { t, locale, release } = Astro.props;
const h = t.home.hero;
const hh = t.homeHero;
const rl = t.ui.repairList;
const st = t.ui.status;
const dl = downloadAttrs(locale);
const langTag = locale === "pt" ? "pt-PT" : locale === "es" ? "es-ES" : "en-IE";
const money = new Intl.NumberFormat(langTag, { style: "currency", currency: "EUR" });
const cut = h.title.indexOf(",");
const titleA = cut > 0 ? h.title.slice(0, cut + 1) : h.title;
const titleB = cut > 0 ? h.title.slice(cut + 1).trim() : "";
const rows = rl.rows.slice(0, 5);
const first = rows[0];
const chipClass: Record<string, string> = {
  intake: "st-chip-info",
  "waiting-for-parts": "st-chip-warn",
  "in-repair": "st-chip-work",
  done: "st-chip-ok",
  delivered: "st-chip-mute",
};
const noticeText = h.toast.replace(/^[^:]*:\s*/, "");
const announceIntake = `${st.intake} — ${hh.received}: ${hh.receivedSub}.`;
const announceRepair = `${st["in-repair"]} — ${first.device}: ${hh.repairing}.`;
const announceDone = `${st.done} — ${hh.ready} (${hh.readySub}). ${hh.notice}: ${noticeText}`;
const shopIni = hh.shop
  .split(" ")
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<section class="hh hh-home" aria-labelledby="hero-title" data-hh>
  <div class="hh-inner">
    <div class="hh-copy">
      <p class="hh-eyebrow"><span aria-hidden="true"></span>{hh.eyebrow}</p>
      <h1 id="hero-title" class="hh-title">
        <span>{titleA}</span>
        {titleB && <span class="hh-title-b">{titleB}</span>}
      </h1>
      <p class="hh-lead">{h.subtitle}</p>

      <div class="hh-ctas">
        <a {...dl} class="hh-btn hh-btn-primary">
          <Icon name="download" class="h-4 w-4" />
          <span class="dl-v-win">{h.ctaWin}</span>
          <span class="dl-v-desktop">{h.ctaDesktop}</span>
          <span class="dl-v-mobile">{h.ctaMobile}</span>
        </a>
        <a href="#tour" class="hh-btn hh-btn-ghost">{h.ctaSecondary}</a>
      </div>
      <p class="hh-note">
        <span class="dl-v-win">{h.noteWin}</span>
        <span class="dl-v-desktop">{h.noteDesktop}</span>
        <span class="dl-v-mobile">{h.noteMobile}</span>
      </p>
      <!-- Instalador ainda sem assinatura digital: avisar ANTES do clique (só para quem está em Windows). -->
      <p class="hh-warn dl-v-win">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5 15 14H1z"></path><path d="M8 6v3.5M8 11.5v.5"></path></svg>
        <span>
          {hh.smartscreen}
          <a href={`${localeUrl(locale, "/download/")}#dl-steps-title`}>{hh.smartscreenLink}</a>
        </span>
      </p>
      <p class="hh-ways">
        <span>{hh.otherWays}</span>
        <a href={`${localeUrl(locale, "/download/")}#docker`}>{t.home.cta.docker}</a>
        <a href={`${localeUrl(locale, "/download/")}#portable`}>{t.home.cta.portable}</a>
        <a href={localeUrl(locale, "/docs/")}>{t.home.cta.guide}</a>
      </p>

      <ul class="hh-trust" role="list">
        {
          h.trust.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              {item}
            </li>
          ))
        }
        {
          release && (
            <li>
              <a href={localeUrl(locale, "/updates/")} class="hh-version">
                {h.versionLabel} <span>{release.version}</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <figure class="hh-stage">
      <div class="hh-dock">
        <span class="hh-dock-label" id="hh-dock-label">
          <span class="hh-dock-dot" aria-hidden="true"></span>
          {hh.tryLabel}
        </span>
        <div class="hh-dock-group" role="group" aria-labelledby="hh-dock-label">
          <button type="button" class="hh-dock-btn" data-set-state="intake" data-announce={announceIntake} aria-pressed="false">
            <span class="hh-dock-pip" aria-hidden="true"></span>
            {st.intake}
          </button>
          <button type="button" class="hh-dock-btn" data-set-state="in-repair" data-announce={announceRepair} aria-pressed="true">
            <span class="hh-dock-pip" aria-hidden="true"></span>
            {st["in-repair"]}
          </button>
          <button type="button" class="hh-dock-btn" data-set-state="done" data-announce={announceDone} aria-pressed="false">
            <span class="hh-dock-pip" aria-hidden="true"></span>
            {st.done}
          </button>
        </div>
        <span class="sr-only" aria-live="polite" data-hh-live-announce></span>
      </div>

      <!-- Palco flutuante macOS + iPhone 16 -->
      <div class="st-scene" aria-hidden="true">
        <!-- Notificação iOS Liquid Glass -->
        <div class="st-ios-notice">
          <span class="st-ios-ico">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"></path></svg>
          </span>
          <span class="st-ios-text">
            <small>{hh.notice}</small>
            <b>{noticeText}</b>
          </span>
        </div>

        <!-- Janela macOS da OficinaOS -->
        <div class="st-mac">
          <div class="st-mac-bar">
            <span class="st-dots"><i></i><i></i><i></i></span>
            <span class="st-mac-crumb"><b>OficinaOS</b> / {rl.title}</span>
            <span class="st-mac-pill"><i></i>Local · LAN</span>
          </div>
          <div class="st-mac-body">
            <div class="st-side">
              <span class="st-side-ico is-active">
                <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
              </span>
              <span class="st-side-ico">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
              </span>
              <span class="st-side-ico">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>
              </span>
              <span class="st-side-ico">
                <svg viewBox="0 0 24 24"><path d="m7.5 4.27 9 5.15" /><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5" /><path d="M12 22V12" /></svg>
              </span>
              <span class="st-side-ico">
                <svg viewBox="0 0 24 24"><rect width="20" height="14" x="2" y="5" rx="2" /><path d="M2 10h20" /></svg>
              </span>
            </div>
            <div class="st-main">
              <div class="st-toolbar">
                <b class="st-toolbar-title">{rl.title}</b>
                <span class="st-search">
                  <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                  {rl.search}
                </span>
                <span class="st-new-btn">+ {rl.newRepair}</span>
              </div>
              <ul class="st-rows" role="list">
                {
                  rows.map((r, i) => (
                    <li class:list={["st-row", i === 0 && "st-row-live"]}>
                      <span class="st-row-id">{r.id}</span>
                      <span class="st-row-dev">
                        <b>{r.device}</b>
                        <small>{r.issue}</small>
                      </span>
                      <span class="st-row-cust">{r.customer}</span>
                      {i === 0 ? (
                        <span class="st-chips">
                          <span class="st-chip st-chip-info st-chip-intake">{st.intake}</span>
                          <span class="st-chip st-chip-work st-from">{st["in-repair"]}</span>
                          <span class="st-chip st-chip-ok st-to">{st.done}</span>
                        </span>
                      ) : (
                        <span class={`st-chip ${chipClass[r.status] ?? "st-chip-mute"}`}>{st[r.status as keyof typeof st]}</span>
                      )}
                      <span class="st-row-total">{money.format(r.total)}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="st-mac-toast">
                <span class="st-mac-toast-ok"><svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"></path></svg></span>
                {h.toast}
              </p>
            </div>
          </div>
        </div>

        <!-- iPhone 16 sobreposto (portal do cliente cheio de ponta a ponta) -->
        <div class="st-iphone">
          <div class="st-iphone-screen">
            <div class="st-ios-status">
              <span>9:41</span>
              <span class="st-island"></span>
              <span class="st-ios-sig"><i></i></span>
            </div>
            <p class="st-pho-shop">
              <span class="st-pho-avatar">{shopIni}</span>
              {hh.shop}
            </p>
            <div class="st-pho-card">
              <p class="st-pho-label">{hh.track}</p>
              <p class="st-pho-dev">{first.device}</p>
              <p class="st-pho-meta">{first.id} · {first.issue}</p>
            </div>
            <ol class="st-pho-steps">
              {hh.steps.map((s, i) => <li class:list={[i < 2 && "is-done", i === 1 && "st-step-mid", i === 2 && "st-step-last"]}>{s}</li>)}
            </ol>
            <div class="st-pho-state">
              <div class="st-pho-box st-pho-intake">
                <b>{hh.received}</b>
                <small>{hh.receivedSub}</small>
              </div>
              <div class="st-pho-box st-pho-work">
                <b>{hh.repairing}</b>
                <small>{first.issue}</small>
              </div>
              <div class="st-pho-box st-pho-done">
                <b>{hh.ready}</b>
                <small>{hh.readySub}</small>
              </div>
            </div>
            <div class="st-pho-foot">
              <span>{t.home.tour.ui.quote.total}</span>
              <b>{money.format(first.total)}</b>
            </div>
            <span class="st-home-ind"></span>
          </div>
        </div>
      </div>
      <figcaption class="hh-caption">{hh.caption}</figcaption>
    </figure>
  </div>
</section>

<script is:inline>
  // 1) A história inicial só arranca quando o palco entra no ecrã (IntersectionObserver).
  // 2) O dock Liquid Glass (e o clique na linha viva) alterna entre Receção, Em reparação e Pronto.
  (function () {
    var s = document.querySelector("[data-hh]");
    if (!s) return;
    var btns = s.querySelectorAll("[data-set-state]");
    var announce = s.querySelector("[data-hh-live-announce]");
    var order = ["intake", "in-repair", "done"];
    var current = "in-repair";
    var io = null;
    var syncTimer = null;

    function clearSync() {
      if (syncTimer) {
        clearTimeout(syncTimer);
        syncTimer = null;
      }
    }

    function setState(next, interactive) {
      current = next;
      if (interactive) {
        clearSync();
        if (io) {
          io.disconnect();
          io = null;
        }
        s.classList.remove("hh-wait");
        s.classList.add("hh-live");
      }
      s.setAttribute("data-state", next);
      btns.forEach(function (b) {
        var active = b.getAttribute("data-set-state") === next;
        b.setAttribute("aria-pressed", active ? "true" : "false");
        if (active && interactive && announce) {
          announce.textContent = b.getAttribute("data-announce") || (b.textContent ? b.textContent.trim() : "");
        }
      });
    }

    function startStorySync() {
      if (s.classList.contains("hh-live")) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        setState("done", false);
        return;
      }
      setState("in-repair", false);
      clearSync();
      syncTimer = setTimeout(function () {
        if (!s.classList.contains("hh-live")) setState("done", false);
      }, 1450);
    }

    btns.forEach(function (b) {
      b.addEventListener("click", function () {
        var next = b.getAttribute("data-set-state");
        if (next) setState(next, true);
      });
    });

    var liveRow = s.querySelector(".st-row-live");
    if (liveRow) {
      liveRow.addEventListener("click", function () {
        var next = order[(order.indexOf(current) + 1) % order.length];
        setState(next, true);
      });
    }

    var target = s.querySelector(".st-row-live") || s.querySelector(".st-mac");
    if (!target || !("IntersectionObserver" in window)) {
      startStorySync();
      return;
    }
    var r = target.getBoundingClientRect();
    if (r.top < innerHeight && r.bottom > 0) {
      startStorySync();
      return;
    }
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setState("done", false);
      return;
    }
    setState("in-repair", false);
    s.classList.add("hh-wait");
    io = new IntersectionObserver(
      function (es) {
        if (es[0].intersectionRatio >= 0.1) {
          s.classList.remove("hh-wait");
          startStorySync();
          if (io) {
            io.disconnect();
            io = null;
          }
        }
      },
      { threshold: [0, 0.1] },
    );
    io.observe(target);
  })();
</script>
