---
// Hero da home (fase 2): texto à esquerda, UI real recriada à direita (a sangrar da grelha).
// LCP = o H1 (texto, sem imagem). A lista de reparações é HTML com um estado que muda e um
// aviso ao cliente — só CSS (opacity/transform), parado com prefers-reduced-motion.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import { downloadAttrs } from "../../lib/download";
import type { ReleaseInfo } from "../../lib/release";
import Icon from "../Icon.astro";
import RepairList from "../mocks/RepairList.astro";
import UiFrame from "../ui/UiFrame.astro";

interface Props {
  t: Copy;
  locale: Locale;
  release: ReleaseInfo | null;
}
const { t, locale, release } = Astro.props;
const h = t.home.hero;
const dl = downloadAttrs(locale);
---

<section class="relative isolate overflow-x-clip" aria-labelledby="hero-title">
  <div class="bg-tech-grid tech-grid-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-10 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:pt-20 lg:pb-24">
    <div class="min-w-0">
      <h1
        id="hero-title"
        class="text-[clamp(2.25rem,5.2vw,3.5rem)] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance text-text"
      >
        {h.title}
      </h1>
      <p class="mt-5 max-w-xl text-pretty text-lg text-text-muted sm:text-xl">{h.subtitle}</p>

      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-5">
        <a
          {...dl}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-5 text-md font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-hover"
        >
          <Icon name="download" class="h-4 w-4" />
          <span class="dl-v-win">{h.ctaWin}</span>
          <span class="dl-v-desktop">{h.ctaDesktop}</span>
          <span class="dl-v-mobile">{h.ctaMobile}</span>
        </a>
        <a
          href="#tour"
          class="inline-flex h-12 items-center justify-center gap-1.5 rounded-md px-2 text-md font-semibold text-link underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary-hover sm:justify-start"
        >
          {h.ctaSecondary}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>
        </a>
      </div>
      <p class="mt-3 text-sm text-text-muted">
        <span class="dl-v-win">{h.noteWin}</span>
        <span class="dl-v-desktop">{h.noteDesktop}</span>
        <span class="dl-v-mobile">{h.noteMobile}</span>
      </p>

      <ul role="list" class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-text-muted">
        {
          h.trust.map((item) => (
            <li class="inline-flex items-center gap-1.5">
              <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m5 13 4 4L19 7" />
              </svg>
              {item}
            </li>
          ))
        }
        {
          release && (
            <li>
              <a
                href={localeUrl(locale, "/updates/")}
                class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2.5 py-0.5 text-text-muted transition-colors hover:border-border-strong hover:text-text"
              >
                {h.versionLabel} <span class="num font-mono text-xs text-text">{release.version}</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div class="min-w-0 lg:-mr-28 xl:-mr-44">
      <UiFrame title={h.frameTitle} caption={h.frameCaption}>
        <RepairList t={t} locale={locale} highlight={0} liveRow={0} liveTo="done" />
        <div
          class="hero-toast absolute right-3 bottom-3 max-w-[calc(100%-1.5rem)] items-center gap-2.5 rounded-lg border border-border bg-surface px-3.5 py-2.5 text-sm font-medium text-text shadow-lg"
          aria-hidden="true"
        >
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-success-soft text-on-success-soft">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7" /></svg>
          </span>
          <span class="min-w-0">{h.toast}</span>
        </div>
      </UiFrame>
    </div>
  </div>
</section>
