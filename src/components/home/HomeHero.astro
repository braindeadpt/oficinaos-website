---
// Herói da página inicial (redesenho 2026-11, direção «Oficina limpa»).
// Fotografia gerada por IA (balcão de uma loja, ecrãs de frente e vazios) com a interface verdadeira
// colada nos ecrãs. Os ecrãs da foto são retângulos quase perfeitos, por isso basta posicioná-los
// em percentagem; o conteúdo escala com a caixa (container queries, unidades cqi).
// A história corre UMA vez, em menos de 5 s, em animações CSS (sem botão de pausa — WCAG 2.2.2 não se
// aplica abaixo de 5 s): a reparação do iPhone 13 passa a «Pronto» no portátil, a página da cliente
// no telemóvel muda ao mesmo tempo e aparece o aviso. Um script pequeno (melhoria progressiva) põe as
// animações em pausa até a fotografia estar à vista; sem JavaScript começam ao carregar a página.
// Com «reduzir movimento» mostra logo o estado final. CSP: sem estilos inline; o script entra por hash.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import { downloadAttrs } from "../../lib/download";
import type { ReleaseInfo } from "../../lib/release";
import Icon from "../Icon.astro";
import "../../styles/photo-hero.css";

interface Props {
  t: Copy;
  locale: Locale;
  release: ReleaseInfo | null;
}
const { t, locale, release } = Astro.props;
const h = t.home.hero;
const hh = t.homeHero;
const rl = t.ui.repairList;
const st = t.ui.status;
const dl = downloadAttrs(locale);
const base = import.meta.env.BASE_URL;
const langTag = locale === "pt" ? "pt-PT" : locale === "es" ? "es-ES" : "en-IE";
const money = new Intl.NumberFormat(langTag, { style: "currency", currency: "EUR" });
// Título em dois tons: a parte depois da vírgula fica mais clara.
const cut = h.title.indexOf(",");
const titleA = cut > 0 ? h.title.slice(0, cut + 1) : h.title;
const titleB = cut > 0 ? h.title.slice(cut + 1).trim() : "";
const rows = rl.rows.slice(0, 5);
const first = rows[0];
const chipClass: Record<string, string> = {
  intake: "hh-chip-info",
  "waiting-for-parts": "hh-chip-warn",
  "in-repair": "hh-chip-work",
  done: "hh-chip-ok",
  delivered: "hh-chip-mute",
};
// Texto do aviso sem o prefixo («Cliente avisado: …»).
const noticeText = h.toast.replace(/^[^:]*:\s*/, "");
---

<section class="hh hh-home" aria-labelledby="hero-title" data-hh>
  <div class="hh-inner">
    <div class="hh-copy">
      <p class="hh-eyebrow"><span aria-hidden="true"></span>{hh.eyebrow}</p>
      <h1 id="hero-title" class="hh-title">
        <span>{titleA}</span>
        {titleB && <span class="hh-title-b">{titleB}</span>}
      </h1>
      <p class="hh-lead">{h.subtitle}</p>

      <div class="hh-ctas">
        <a {...dl} class="hh-btn hh-btn-primary">
          <Icon name="download" class="h-4 w-4" />
          <span class="dl-v-win">{h.ctaWin}</span>
          <span class="dl-v-desktop">{h.ctaDesktop}</span>
          <span class="dl-v-mobile">{h.ctaMobile}</span>
        </a>
        <a href="#tour" class="hh-btn hh-btn-ghost">{h.ctaSecondary}</a>
      </div>
      <p class="hh-note">
        <span class="dl-v-win">{h.noteWin}</span>
        <span class="dl-v-desktop">{h.noteDesktop}</span>
        <span class="dl-v-mobile">{h.noteMobile}</span>
      </p>

      <ul class="hh-trust" role="list">
        {
          h.trust.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              {item}
            </li>
          ))
        }
        {
          release && (
            <li>
              <a href={localeUrl(locale, "/updates/")} class="hh-version">
                {h.versionLabel} <span>{release.version}</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <figure class="hh-stage">
      <div class="hh-photo">
        <div class="hh-frame">
        <img
          class="hh-img"
          src={`${base}images/home-hero.webp`}
          srcset={`${base}images/home-hero-800.webp 800w, ${base}images/home-hero.webp 1264w`}
          sizes="(max-width: 40rem) 170vw, (min-width: 80rem) 76rem, 100vw"
          width="1264"
          height="848"
          alt={hh.caption}
          fetchpriority="high"
          decoding="async"
        />

        <!-- Ecrã do portátil: lista de reparações -->
        <div class="hh-lap" aria-hidden="true">
          <div class="hh-app">
            <div class="hh-side">
              <span class="hh-logo"></span>
              <i class="is-on"></i><i></i><i></i><i></i><i></i>
            </div>
            <div class="hh-main">
              <div class="hh-bar">
                <b>{rl.title}</b>
                <span class="hh-search">{rl.search}</span>
                <span class="hh-new">+ {rl.newRepair}</span>
              </div>
              <ul class="hh-rows" role="list">
                {
                  rows.map((r, i) => (
                    <li class:list={["hh-row", i === 0 && "hh-row-live"]}>
                      <span class="hh-id">{r.id}</span>
                      <span class="hh-dev">
                        <b>{r.device}</b>
                        <small>{r.issue}</small>
                      </span>
                      <span class="hh-cust">{r.customer}</span>
                      {i === 0 ? (
                        <span class="hh-chips">
                          <span class="hh-chip hh-chip-work hh-from">{st["in-repair"]}</span>
                          <span class="hh-chip hh-chip-ok hh-to">{st.done}</span>
                        </span>
                      ) : (
                        <span class={`hh-chip ${chipClass[r.status] ?? "hh-chip-mute"}`}>{st[r.status as keyof typeof st]}</span>
                      )}
                      <span class="hh-total">{money.format(r.total)}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="hh-toast">
                <span class="hh-ok"><svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"></path></svg></span>
                {h.toast}
              </p>
            </div>
          </div>
        </div>

        <!-- Ecrã do telemóvel: a página de acompanhamento que a cliente vê -->
        <div class="hh-pho" aria-hidden="true">
          <div class="hh-track">
            <p class="hh-track-shop"><span></span>{hh.shop}</p>
            <p class="hh-track-label">{hh.track}</p>
            <p class="hh-track-dev">{first.device}</p>
            <p class="hh-track-id">{first.id}</p>
            <ol class="hh-steps">
              {hh.steps.map((s, i) => <li class:list={[i < 2 && "is-done", i === 2 && "hh-step-last"]}>{s}</li>)}
            </ol>
            <div class="hh-state">
              <p class="hh-state-from">{hh.repairing}</p>
              <p class="hh-state-to">
                <b>{hh.ready}</b>
                <small>{hh.readySub}</small>
              </p>
            </div>
          </div>
        </div>

        </div>

        <!-- Aviso enviado à cliente -->
        <div class="hh-notice" aria-hidden="true">
          <span class="hh-notice-ico">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"></path></svg>
          </span>
          <span class="hh-notice-text">
            <small>{hh.notice}</small>
            <b>{noticeText}</b>
          </span>
        </div>
      </div>
      <figcaption class="hh-caption">{hh.caption}</figcaption>
    </figure>
  </div>
</section>

<script is:inline>
  // A história só começa quando a fotografia está à vista: se a página abre com a foto abaixo da dobra
  // (ecrã baixo), as animações ficam em pausa até ela entrar no ecrã. Sem JS, correm logo ao carregar.
  (function () {
    // O alvo é o ecrã do portátil (onde a história acontece), não o topo da fotografia.
    var s = document.querySelector("[data-hh]");
    var target = s && s.querySelector(".hh-lap");
    if (!target || !("IntersectionObserver" in window)) return;
    var r = target.getBoundingClientRect();
    if (r.top >= 0 && r.bottom <= innerHeight) return; // ecrã já todo à vista: corre já
    s.classList.add("hh-wait");
    var io = new IntersectionObserver(
      function (es) {
        if (es[0].intersectionRatio >= 0.6) {
          s.classList.remove("hh-wait");
          io.disconnect();
        }
      },
      { threshold: [0, 0.6, 1] },
    );
    io.observe(target);
  })();
</script>
