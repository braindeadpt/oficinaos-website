---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { localeUrl } from "../i18n/utils";
import { downloadAttrs } from "../lib/download";
import DocSections from "./DocSections.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import Nav from "./Nav.astro";

interface Props {
  t: Copy;
  locale: Locale;
  /** Conteúdo da página — `t.seoPage` ou uma entrada de `seoPages`. */
  page: Copy["seoPage"] & {
    ctaSecondaryHref?: string;
    /** Resposta direta em 1-2 frases — extraível por LLMs — mostrada sob o subtítulo. */
    answer?: string;
    faqTitle?: string;
    faqs?: { q: string; a: string }[];
  };
  /** Locales em que a página existe (páginas de conteúdo pt-only). */
  pageLocales?: readonly Locale[];
}
const { t, locale } = Astro.props;
const p = Astro.props.page;
---

<Nav t={t} locale={locale} pageLocales={Astro.props.pageLocales} />
<main id="main" tabindex="-1" class="mx-auto max-w-3xl px-6 py-16">
  <span
    class="inline-flex items-center gap-2 rounded-full border border-primary-soft bg-primary-soft px-4 py-1.5 text-xs font-medium text-on-primary-soft"
  >
    <Icon name="shield" class="h-3.5 w-3.5" />
    {p.badge}
  </span>
  <h1
    class="mt-6 text-[clamp(1.75rem,5vw,2.5rem)] leading-[1.12] font-extrabold tracking-tight text-balance text-text"
  >
    {p.title}
  </h1>
  <p class="mt-5 text-lg text-text-muted">{p.subtitle}</p>
  {
    p.answer && (
      <p class="mt-4 border-l-2 border-primary pl-4 text-md text-text">{p.answer}</p>
    )
  }

  <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row">
    <a
      {...downloadAttrs(locale)}
      class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-[18px] text-md font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover"
    >
      <Icon name="download" class="h-4 w-4" />
      {p.ctaPrimary}
    </a>
    <a
      href={localeUrl(locale, p.ctaSecondaryHref ?? "/docs")}
      class="inline-flex h-12 items-center justify-center gap-2 rounded-md border border-border-strong bg-surface px-[18px] text-md font-semibold text-text transition hover:bg-surface-2"
    >
      {p.ctaSecondary}
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-14">
    <DocSections sections={p.sections} />
  </div>

  {
    p.faqs?.length ? (
      <div class="mt-14">
        <h2 class="text-xl font-bold text-text">{p.faqTitle}</h2>
        <div class="mt-4 space-y-3">
          {p.faqs!.map((f) => (
            <details class="rounded-lg border border-border bg-surface p-4">
              <summary class="cursor-pointer text-md font-semibold text-text">{f.q}</summary>
              <p class="mt-2 text-md text-text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    ) : null
  }

  <div class="mt-16 rounded-lg border border-border bg-surface p-8 text-center">
    <h2 class="text-xl font-bold text-text">{p.ctaTitle}</h2>
    <p class="mx-auto mt-3 max-w-xl text-text-muted">{p.ctaText}</p>
    <div class="mt-6 flex flex-col items-stretch justify-center gap-3 sm:flex-row">
      <a
        {...downloadAttrs(locale)}
        class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-[18px] text-md font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover"
      >
        <Icon name="download" class="h-4 w-4" />
        {p.ctaPrimary}
      </a>
      <a
        href={localeUrl(locale, p.ctaSecondaryHref ?? "/docs")}
        class="inline-flex h-12 items-center justify-center gap-2 rounded-md border border-border-strong bg-surface px-[18px] text-md font-semibold text-text transition hover:bg-surface-2"
      >
        {p.ctaSecondary}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</main>
<Footer t={t} locale={locale} />
