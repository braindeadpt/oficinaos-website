---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { slugify } from "../i18n/utils";
import DocSections from "./DocSections.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<Nav t={t} locale={locale} />
<main class="mx-auto max-w-3xl px-6 py-16">
  <h1 class="text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
    {t.docs.title}
  </h1>
  <p class="mt-4 text-lg text-text-muted">{t.docs.subtitle}</p>

  <nav class="mt-10 rounded-lg border border-border bg-surface p-6">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-text-muted">
      {t.docs.toc}
    </h2>
    <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
      {
        t.docs.sections.map((s) => (
          <li>
            <a
              href={`#${slugify(s.heading)}`}
              class="text-text-muted transition hover:text-primary-hover"
            >
              {s.heading}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-12">
    <DocSections sections={t.docs.sections} />
  </div>
</main>
<Footer t={t} />
