---
// /docs/ — guia completo, no layout da documentação (fase 5).
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import DocsShell from "./docs/DocsShell.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<DocsShell
  t={t}
  locale={locale}
  current="overview"
  title={t.docs.title}
  subtitle={t.docs.subtitle}
  sections={t.docs.sections}
/>
