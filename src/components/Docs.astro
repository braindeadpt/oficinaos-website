---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { slugify } from "../i18n/utils";
import DocSections from "./DocSections.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
---

<Nav t={t} locale={locale} />
<main class="mx-auto max-w-3xl px-6 py-16">
  <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
    {t.docs.title}
  </h1>
  <p class="mt-4 text-lg text-zinc-400">{t.docs.subtitle}</p>

  <nav class="mt-10 rounded-xl border border-zinc-800 bg-zinc-900/40 p-6">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
      {t.docs.toc}
    </h2>
    <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
      {
        t.docs.sections.map((s) => (
          <li>
            <a
              href={`#${slugify(s.heading)}`}
              class="text-zinc-400 transition hover:text-teal-300"
            >
              {s.heading}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="mt-12">
    <DocSections sections={t.docs.sections} />
  </div>
</main>
<Footer t={t} />
