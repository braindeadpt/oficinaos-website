---
import type { Copy } from "../i18n/pt";
import Icon from "./Icon.astro";
import {
  INSTALL_URL,
  INSTALL_ZIP_URL,
  RELEASES_URL,
  REPO_URL,
  SETUP_EXE_URL,
} from "../i18n/utils";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<section id="install" class="mx-auto max-w-6xl px-6 py-24">
  <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
    <div class="min-w-0">
      <h2 class="text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
        {t.install.title}
      </h2>
      <p class="mt-4 text-lg text-text-muted">{t.install.subtitle}</p>
      <ol class="mt-10 space-y-6">
        {
          t.install.steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">
                {i + 1}
              </span>
              <div>
                <h3 class="font-semibold text-text">{s.title}</h3>
                <p class="mt-1 text-sm text-text-muted">{s.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={SETUP_EXE_URL}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-[18px] text-md font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover"
        >
          <Icon name="download" class="h-4 w-4" />
          {t.install.downloadButton}
        </a>
        <a
          href={INSTALL_ZIP_URL}
          class="text-sm font-medium text-link transition hover:text-primary-hover"
        >
          {t.install.dockerLink}
        </a>
      </div>
      <p class="mt-3 text-xs text-text-muted">{t.install.downloadNote}</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a
          href={INSTALL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-link transition hover:text-primary-hover"
        >
          {t.install.guideLink}
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
        <a
          href={RELEASES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-link transition hover:text-primary-hover"
        >
          {t.install.releasesLink}
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
    <div id="install-advanced" class="min-w-0 scroll-mt-24">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border-strong bg-surface px-3 py-1 text-xs font-medium text-text-muted"
      >
        <Icon name="terminal" class="h-3.5 w-3.5" />
        {t.install.advanced.badge}
      </span>
      <h3 class="mt-4 text-xl font-semibold text-text">
        {t.install.advanced.title}
      </h3>
      <p class="mt-2 text-sm text-text-muted">{t.install.advanced.desc}</p>
      <div
        class="mt-6 overflow-hidden rounded-lg border border-border bg-surface-2"
      >
        <div
          class="flex items-center gap-2 border-b border-border bg-surface px-4 py-2.5 text-xs font-medium text-text-muted"
        >
          <Icon name="terminal" class="h-3.5 w-3.5" />
          <span>Linux / macOS</span>
        </div>
        <pre
          class="overflow-x-auto whitespace-pre-wrap break-words p-4 font-mono text-[13px] leading-relaxed text-text sm:p-6 sm:text-sm"><code><span class="text-text-muted"># {t.install.advanced.commentGet}</span>
<span class="select-none text-primary">$</span> git clone {REPO_URL}.git
<span class="select-none text-primary">$</span> cd OficinaOS && cp .env.example .env

<span class="text-text-muted"># {t.install.advanced.commentStart}</span>
<span class="select-none text-primary">$</span> docker compose up -d
<span class="select-none text-primary">$</span> docker compose exec app bun run db:seed

<span class="text-text-muted"># {t.install.advanced.commentOpen}</span>
<span class="text-link">http://localhost:4000</span></code></pre>
      </div>
      <p class="mt-3 text-xs text-text-muted">{t.install.advanced.note}</p>
    </div>
  </div>
</section>
