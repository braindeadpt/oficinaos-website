---
// Bifurcação da página inicial: quem tem uma oficina segue para a OficinaOS (grátis) e o Pro;
// qualquer outra empresa vai para os módulos vendidos à parte (lista de espera).
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const f = t.home.fork;
const modules = [
  { name: t.modulePages.ponto.hero.label, desc: t.nav.moduleItems.ponto, href: localeUrl(locale, "/livro-de-ponto/") },
  { name: t.modulePages.atendimento.hero.label, desc: t.nav.moduleItems.atendimento, href: localeUrl(locale, "/atendimento-ia/") },
];
---

<section class="border-y border-border bg-surface" aria-labelledby="fork-title">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <h2 id="fork-title" class="text-center font-display text-xl font-bold tracking-[-0.015em] text-text sm:text-2xl">{f.title}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div data-product="os" class="flex flex-col rounded-xl border border-border bg-bg p-6">
        <p class="flex items-center gap-2 text-sm font-semibold text-product">
          <span class="h-2.5 w-2.5 rounded-[3px] bg-product" aria-hidden="true"></span>
          {f.yesLabel}
        </p>
        <p class="mt-2 font-display text-lg font-bold text-text">{f.yesTitle}</p>
        <p class="mt-1 text-base text-text-muted">{f.yesText}</p>
        <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5">
          <a href="#tour" class="inline-flex items-center gap-1.5 text-sm font-semibold text-link underline underline-offset-4 hover:text-primary-hover">
            {f.yesCta}
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
          <a href={localeUrl(locale, "/pro/")} class="inline-flex items-center gap-1.5 text-sm font-semibold text-link underline underline-offset-4 hover:text-primary-hover">
            {f.yesPro}
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
      <div data-product="pro" class="flex flex-col rounded-xl border border-border bg-bg p-6">
        <p class="flex items-center gap-2 text-sm font-semibold text-product">
          <span class="h-2.5 w-2.5 rounded-full border-2 border-product" aria-hidden="true"></span>
          {f.noLabel}
        </p>
        <p class="mt-2 font-display text-lg font-bold text-text">{f.noTitle}</p>
        <ul role="list" class="mt-3 space-y-2">
          {
            modules.map((m) => (
              <li>
                <a href={m.href} class="group flex items-start justify-between gap-3 rounded-lg border border-border px-3 py-2.5 transition-colors hover:border-product">
                  <span class="min-w-0">
                    <span class="block font-semibold text-text">{m.name}</span>
                    <span class="block text-sm text-text-muted">{m.desc}</span>
                  </span>
                  <Icon name="arrow" class="mt-1 h-4 w-4 shrink-0 text-text-subtle group-hover:text-link" />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs text-text-muted">{f.noNote}</p>
      </div>
    </div>
  </div>
</section>
