---
import type { Copy } from "../i18n/pt";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

const icons = [
  "wrench",
  "cart",
  "box",
  "smartphone",
  "clipboard",
  "bell",
  "globe",
  "tablet",
  "archive",
] as const;
---

<section id="features" class="mx-auto max-w-6xl px-6 py-24">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {t.features.title}
    </h2>
    <p class="mt-4 text-lg text-zinc-400">{t.features.subtitle}</p>
  </div>
  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      t.features.items.map((f, i) => (
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6 transition hover:border-teal-500/40 hover:bg-zinc-900">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-500/10 text-teal-400">
            <Icon name={icons[i]} class="h-5 w-5" />
          </div>
          <h3 class="mt-4 font-semibold text-white">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">{f.desc}</p>
        </div>
      ))
    }
  </div>
</section>
