---
// Página de um módulo vendido também a empresas que não usam a OficinaOS (Livro de Ponto,
// Atendimento IA). Ainda não há subscrição autónoma (precisa da plataforma — fase 3 do plano),
// por isso a página explica tudo e recolhe uma LISTA DE ESPERA; para oficinas, o módulo já vem
// incluído no OficinaOS Pro. Ordem: hero → problema → 3 passos → conversa de exemplo → vantagens →
// porque pode confiar → para quem → o que precisa → preço → incluído no Pro → lista de espera → FAQ.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import { fill, pricing, euro } from "../../lib/pricing";
import Footer from "../Footer.astro";
import Icon from "../Icon.astro";
import Nav from "../Nav.astro";
import PontoBody from "./PontoBody.astro";
import AtendimentoBody from "./AtendimentoBody.astro";
import AtendimentoHero from "./AtendimentoHero.astro";
import PontoHero from "./PontoHero.astro";
import BetaSignup from "../pro/BetaSignup.astro";
import DataTable from "../ui/DataTable.astro";
import Faq from "../ui/Faq.astro";
import Heading from "../ui/Heading.astro";
import Section from "../ui/Section.astro";
import UiFrame from "../ui/UiFrame.astro";

type ModuleCopy = Copy["modulePages"]["ponto"];

interface Props {
  t: Copy;
  locale: Locale;
  m: ModuleCopy;
  /** Identifica o interesse no formulário da lista de espera. */
  interest: "ponto" | "atendimento";
}
const { t, locale, m, interest } = Astro.props;
const check = '<path d="m5 13 4 4L19 7"/>';
const vars = {
  proPrice: euro(locale, pricing.pro.monthlyByok),
  days: pricing.pro.trialDays,
  pontoFrom: euro(locale, pricing.addons.ponto[0].monthly),
  pontoUpTo: pricing.addons.ponto[0].upTo,
};
const stepIcons = ["clipboard", "smartphone", "activity"] as const;
---

<Nav t={t} locale={locale} />
<main id="main" tabindex="-1" data-product="pro">
  {interest === "ponto" ? (
    <PontoHero t={t} locale={locale} />
  ) : interest === "atendimento" ? (
    <AtendimentoHero t={t} locale={locale} />
  ) : (
  <section class="relative isolate overflow-x-clip" aria-labelledby="mod-hero-title">
    <div class="bg-tech-grid tech-grid-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-10 pb-16 sm:px-6 sm:pt-16 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-14 lg:pt-20 lg:pb-24">
      <div class="min-w-0">
        <p class="flex flex-wrap items-center gap-3 text-sm font-semibold text-product">
          <span class="inline-flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-[3px] bg-product" aria-hidden="true"></span>
            {m.hero.label}
          </span>
          <span class="rounded-full bg-product-soft px-2.5 py-0.5 text-xs font-semibold text-on-product-soft">{m.hero.badge}</span>
        </p>
        <h1 id="mod-hero-title" class="mt-3 text-[clamp(2.25rem,5.2vw,3.5rem)] leading-[1.05] font-extrabold tracking-[-0.03em] text-balance text-text">
          {m.hero.title}
        </h1>
        <p class="mt-5 max-w-xl text-pretty text-lg text-text-muted sm:text-xl">{m.hero.subtitle}</p>
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-5">
          <a
            href="#beta"
            class="inline-flex h-12 items-center justify-center gap-2 whitespace-nowrap rounded-md bg-product px-5 text-md font-semibold text-on-product shadow-sm transition-colors hover:bg-product-hover"
          >
            {m.hero.cta}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a
            href="#como-funciona"
            class="inline-flex h-12 items-center justify-center whitespace-nowrap rounded-md px-2 text-md font-semibold text-link underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary-hover sm:justify-start"
          >
            {m.hero.ctaSecondary}
          </a>
        </div>
        <p class="mt-5 text-sm text-text-muted">
          {m.hero.proNote}
          <a href={localeUrl(locale, "/pro/")} class="font-semibold text-link underline underline-offset-2 hover:text-primary-hover">{m.hero.proLink}</a>
        </p>
      </div>

      <div class="min-w-0">
        <UiFrame title={m.chat.title} product="pro" caption={m.chat.caption} class="mx-auto max-w-md">
          <ol role="list" class="space-y-2.5 bg-surface-2 p-4 text-sm sm:p-5" aria-hidden="true">
            {
              m.chat.messages.map(([who, text]) => (
                <li class:list={["flex", who === "in" ? "justify-end" : "justify-start"]}>
                  <p
                    class:list={[
                      "max-w-[85%] rounded-2xl px-3.5 py-2",
                      who === "in" ? "rounded-br-sm bg-product-soft text-on-product-soft" : "rounded-bl-sm border border-border bg-surface text-text",
                    ]}
                  >
                    {text}
                  </p>
                </li>
              ))
            }
          </ol>
        </UiFrame>
        <p class="mx-auto mt-3 max-w-md text-center text-xs text-text-muted">{m.chat.note}</p>
      </div>
    </div>
  </section>
  )}

  {interest === "ponto" ? (
    <PontoBody t={t} locale={locale} />
  ) : interest === "atendimento" ? (
    <AtendimentoBody t={t} locale={locale} />
  ) : (
  <>
  <Section id="problema" tone="raised" width="narrow" labelledby="problem-title">
    <Heading id="problem-title">
      {m.problem.title}
      <Fragment slot="lead">{m.problem.lead}</Fragment>
    </Heading>
    <ul role="list" class="mt-8 space-y-3">
      {
        m.problem.items.map((it) => (
          <li class="rounded-lg border border-border bg-bg px-4 py-3">
            <p class="font-semibold text-text">{it.title}</p>
            <p class="mt-0.5 text-base text-text-muted">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="como-funciona" product="pro" labelledby="steps-title">
    <Heading id="steps-title">
      {m.steps.title}
      <Fragment slot="lead">{m.steps.lead}</Fragment>
    </Heading>
    <ol role="list" class="reveal mt-10 grid gap-6 md:grid-cols-3">
      {
        m.steps.items.map((s, i) => (
          <li class="rounded-xl border border-border bg-surface p-5 shadow-sm">
            <span class="flex items-center gap-3">
              <span class="num grid h-8 w-8 place-items-center rounded-full bg-product text-sm font-bold text-on-product" aria-hidden="true">{i + 1}</span>
              <Icon name={stepIcons[i % stepIcons.length]} class="h-5 w-5 text-text-muted" />
            </span>
            <h3 class="mt-4 font-display text-lg font-bold text-text">{s.title}</h3>
            <p class="mt-1.5 text-base text-text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="vantagens" tone="raised" product="pro" labelledby="benefits-title">
    <Heading id="benefits-title">{m.benefits.title}</Heading>
    <ul role="list" class="reveal mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        m.benefits.items.map((b) => (
          <li class="rounded-xl border border-border bg-bg p-5">
            <span class="grid h-8 w-8 place-items-center rounded-full bg-product-soft text-on-product-soft" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
            </span>
            <h3 class="mt-3 font-display text-lg font-bold text-text">{b.title}</h3>
            <p class="mt-1 text-base text-text-muted">{b.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="confianca" product="pro" labelledby="trust-title">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="min-w-0">
        <Heading id="trust-title">
          {m.trust.title}
          <Fragment slot="lead">{m.trust.lead}</Fragment>
        </Heading>
        <ol role="list" class="mt-8 space-y-4">
          {
            m.trust.items.map((it, i) => (
              <li class="flex gap-4">
                <span class="num grid h-8 w-8 shrink-0 place-items-center rounded-full bg-product-soft text-sm font-bold text-on-product-soft" aria-hidden="true">{i + 1}</span>
                <span class="min-w-0">
                  <span class="block font-semibold text-text">{it.title}</span>
                  <span class="mt-0.5 block text-base text-text-muted">{it.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="min-w-0 rounded-xl border border-border bg-surface p-6">
        <h3 class="font-display text-lg font-bold text-text">{m.privacy.title}</h3>
        <ul role="list" class="mt-4 space-y-2.5">
          {
            m.privacy.items.map((it) => (
              <li class="flex items-start gap-2.5 text-base text-text">
                <Icon name="shield" class="mt-0.5 h-4 w-4 shrink-0 text-product" />
                {it}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section id="para-quem" tone="raised" product="pro" labelledby="who-title">
    <Heading id="who-title">{m.forWhom.title}</Heading>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-border bg-bg p-6">
        <p class="font-semibold text-text">{m.forWhom.yesTitle}</p>
        <ul role="list" class="mt-3 flex flex-wrap gap-2">
          {m.forWhom.yes.map((y) => <li class="rounded-full bg-product-soft px-3 py-1 text-sm font-medium text-on-product-soft">{y}</li>)}
        </ul>
      </div>
      <div class="rounded-xl border border-border bg-bg p-6">
        <p class="font-semibold text-text">{m.forWhom.noTitle}</p>
        <p class="mt-3 text-base text-text-muted">{m.forWhom.no}</p>
      </div>
    </div>

    <h3 class="mt-14 font-display text-xl font-bold text-text">{m.needs.title}</h3>
    <DataTable class="mt-4" caption={m.needs.title} label={`${m.needs.title} — ${m.needs.scrollLabel}`} head={m.needs.head} rows={m.needs.rows} stack />
    <p class="mt-4 text-sm text-text-muted">{m.needs.note}</p>
  </Section>

  <Section id="preco" width="narrow" product="pro" labelledby="price-title">
    <Heading id="price-title">
      {m.pricing.title}
      <Fragment slot="lead">{m.pricing.lead}</Fragment>
    </Heading>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-border bg-surface p-6">
        <p class="font-semibold text-text">{m.pricing.standaloneTitle}</p>
        <p class="mt-2 text-base text-text-muted">{m.pricing.standaloneText}</p>
      </div>
      <div class="rounded-xl border-2 border-product bg-bg p-6">
        <p class="font-semibold text-text">{m.pricing.proTitle}</p>
        <p class="mt-2 text-base text-text-muted">{fill(m.pricing.proText, vars)}</p>
        <a href={localeUrl(locale, "/pro/")} class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-link underline underline-offset-4 hover:text-primary-hover">
          {m.pricing.proLink}
          <Icon name="arrow" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
    <p class="mt-4 text-sm text-text-muted">{m.pricing.note}</p>
  </Section>

  </>
  )}

  <div class="pb-wait">
    <Section width="default" product="pro" pad="md">
      <BetaSignup
        t={t}
        title={m.waitlist.title}
        subtitle={m.waitlist.subtitle}
        button={m.waitlist.button}
        interest={interest}
        note={interest === "ponto" ? t.pontoPage.waitlist.note : t.atendimentoPage.waitlist.note}
        shopPlaceholder={interest === "ponto" ? t.pontoPage.waitlist.shopPlaceholder : t.atendimentoPage.waitlist.shopPlaceholder}
        cloudLogin={false}
      />
    </Section>
  </div>

  <div class="pb-faq">
    <Faq title={m.faq.title} items={m.faq.items} product="pro" />
  </div>
</main>
<Footer t={t} locale={locale} />
