        el.row.animate([{ opacity: 0, transform: "translateY(-8px)" }, { opacity: 1, transform: "none" }], { duration: 600, easing: E });
        el.count.textContent = "4";
        a(el.toast, [{ opacity: 0, transform: "translate(-50%, 40%) scale(.96)" }, { opacity: 1, transform: "translate(-50%, 0)" }], { duration: 600 });
      });
      at(8600, function () {
        a(el.toast, [{ opacity: 1, transform: "translate(-50%, 0)" }, { opacity: 0, transform: "translate(-50%, 40%) scale(.96)" }], { duration: 500 });
      });
      // 4. recomeça
      at(10300, function () {
        a(el.chat, [{ opacity: 1 }, { opacity: 0 }], { duration: 450 });
        a(el.cam, [{ opacity: 0 }, { opacity: 1 }], { duration: 450 });
      });
      at(11000, run);
    }
    run();

    /* ---------- pausar / retomar (continua onde parou) ---------- */
    var pauseBtn = q("[data-pause]");
    pauseBtn.addEventListener("click", function () {
      paused = !paused;
      pauseBtn.toggleAttribute("data-paused", paused);
      pauseBtn.setAttribute("aria-label", pauseBtn.getAttribute(paused ? "data-label-play" : "data-label-pause"));
      var anims = root.getAnimations({ subtree: true });
      if (paused) {
        var now = performance.now();
        timers.forEach(function (t) {
          clearTimeout(t.id);
          t.left = Math.max(0, t.due - now);
        });
        anims.forEach(function (x) {
          x.pause();
        });
      } else {
        var pending = timers;
        timers = [];
        pending.forEach(function (t) {
          at(t.left, t.fn);
        });
        anims.forEach(function (x) {
          if (x.playState === "paused") x.play();
        });
      }
    });
  })();
</script>
