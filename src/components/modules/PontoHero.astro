---
// Herói do Livro de Ponto (redesenho 2026-11, direção «Oficina limpa»).
// Fotografia (gerada por IA, ecrãs vazios) com a interface verdadeira colada nos ecrãs em
// mapeamento: o QR da loja muda a cada 30 s no tablet e a picagem acontece no telemóvel. Os ecrãs
// da foto estão de frente; o mapeamento é calculado no script
// (homografia → matrix3d) a partir dos cantos medidos na foto. CSP: sem estilos inline no HTML;
// o script entra por hash. Sem JS ou com «reduzir movimento» fica o estado final, sem animação.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const m = t.modulePages.ponto;
const h = t.pontoHero;
const initials = (name: string) =>
  name
    .split(" ")
    .map((p) => p[0])
    .slice(0, 2)
    .join("");
const base = import.meta.env.BASE_URL;
// A foto base já traz a interface desenhada nos ecrãs (estado final, na língua da página): é o que
// vê quem não tem JavaScript e o primeiro frame de toda a gente; as camadas vivas cobrem-na por cima.
const img = locale === "pt" ? "ponto-hero" : `ponto-hero-${locale}`;
// A mensagem leva o mesmo código que o ecrã mostra: o script troca-o a cada janela de 30 s.
const draftMatch = h.phone.draft.match(/^(.*#)(\d{4})$/);
const draftHead = draftMatch ? draftMatch[1] : h.phone.draft;
const draftCode = draftMatch ? draftMatch[2] : "";
---

<section class="ph" aria-labelledby="ph-title" data-ph data-static>
  <div class="ph-inner">
    <div class="ph-copy">
      <p class="ph-eyebrow">
        <span class="ph-dot" aria-hidden="true"></span>
        {m.hero.label}
        <span class="ph-badge">{m.hero.badge}</span>
      </p>
      <h1 id="ph-title" class="ph-title">
        <span>{h.titleA}</span>
        <span class="ph-title-b">{h.titleB}</span>
      </h1>
      <p class="ph-lead">{m.hero.subtitle}</p>

      <div class="ph-ctas">
        <a href="#beta" class="ph-btn ph-btn-primary">
          {m.hero.cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="#como-funciona" class="ph-btn ph-btn-ghost">{m.hero.ctaSecondary}</a>
      </div>

      <ul class="ph-proofs" role="list">
        {
          h.proofs.map((p) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>

      <p class="ph-pro">
        {m.hero.proNote}
        <a href={localeUrl(locale, "/pro/")}>{m.hero.proLink}</a>
      </p>
    </div>

    <figure class="ph-stage">
      <div class="ph-photo" data-photo>
        <img
          class="ph-img"
          src={`${base}images/${img}.webp`}
          srcset={`${base}images/${img}-800.webp 800w, ${base}images/${img}.webp 1200w`}
          sizes="(min-width: 64rem) 50vw, 100vw"
          width="1200"
          height="896"
          alt={h.caption}
          fetchpriority="high"
          decoding="async"
        />

        <!-- Ecrã do tablet (mapeado em perspetiva sobre o ecrã da foto) -->
        <div class="ph-surface ph-tab" data-quad="672,177 1051.8,177 672,720 1049.3,720" aria-hidden="true">
          <header class="ph-tab-head">
            <span class="ph-shop"><span class="ph-shop-mark"></span>{h.screen.shop}</span>
            <span class="ph-clock" data-clock>09:02</span>
          </header>
          <div class="ph-tab-body">
            <div class="ph-qr-wrap">
              <svg class="ph-ring" viewBox="0 0 120 120">
                <circle class="ph-ring-track" cx="60" cy="60" r="56"></circle>
                <circle class="ph-ring-prog" cx="60" cy="60" r="56" pathLength="100" data-ring></circle>
              </svg>
              <canvas class="ph-qr" width="232" height="232" data-qr></canvas>
            </div>
            <p class="ph-scan">{h.screen.scan}</p>
            <p class="ph-code-label">{h.screen.codeLabel}</p>
            <p class="ph-code" data-code>4821</p>
            <p class="ph-changes">{h.screen.changesIn} <span data-secs>30</span> s</p>
          </div>
          <div class="ph-toast" data-toast>
            <span class="ph-toast-ok"><svg viewBox="0 0 16 16"><path d="m3.5 8.5 3 3 6-7"></path></svg></span>
            {h.screen.toast}
          </div>
        </div>

        <!-- Ecrã do telemóvel -->
        <div class="ph-surface ph-pho" data-quad="373,285 539.4,285 372.4,644 541.8,644" aria-hidden="true">
          <div class="ph-cam" data-cam>
            <!-- o visor mostra o mesmo ecrã do tablet: QR e código copiados do original -->
            <div class="ph-cam-fix" data-camfix>
            <div class="ph-cam-tab">
              <div class="ph-cam-qrbox">
                <canvas class="ph-cam-qr" width="232" height="232" data-qr-cam></canvas>
                <span class="ph-reticle" data-reticle><i></i><i></i><i></i><i></i></span>
              </div>
              <span class="ph-cam-line"></span>
              <span class="ph-cam-code" data-code-cam>4821</span>
            </div>
            </div>
            <p class="ph-detected" data-detected>{h.phone.detected}</p>
          </div>
          <div class="ph-chat" data-chat>
            <div class="ph-chat-head">
              <span class="ph-avatar">OC</span>
              <span class="ph-chat-who"><b>{h.phone.contact}</b><small>{h.phone.contactSub}</small></span>
            </div>
            <div class="ph-chat-feed">
              <p class="ph-bubble ph-out" data-out>
                {draftHead}<span data-draft-code>{draftCode}</span>
                <span class="ph-meta" data-meta>09:02 <svg viewBox="0 0 20 12"><path d="m1 6 3.5 3.5L11 2M8 9.5 9 10.5 18 2"></path></svg></span>
              </p>
              <p class="ph-typing" data-typing><i></i><i></i><i></i></p>
              <p class="ph-bubble ph-in" data-in>
                <b>{h.phone.reply}</b>
                <span>{h.phone.replySub}</span>
              </p>
            </div>
            <div class="ph-composer">
              <span class="ph-input">{h.phone.composer}</span>
              <span class="ph-send"><svg viewBox="0 0 16 16"><path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path></svg></span>
            </div>
          </div>
        </div>

        <!-- Pausar/retomar a demonstração (WCAG 2.2.2): só aparece quando há animação -->
        <button class="ph-pause" type="button" data-pause aria-label={h.demoPause} data-label-pause={h.demoPause} data-label-play={h.demoPlay}>
          <svg class="ph-pause-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9"></path></svg>
          <svg class="ph-play-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z"></path></svg>
        </button>

        <!-- Painel do gestor -->
        <div class="ph-panel" aria-hidden="true">
          <header class="ph-panel-head">
            <span>{h.panel.title}</span>
            <span class="ph-count"><span class="ph-live"></span><span data-count>4</span></span>
          </header>
          <ul class="ph-rows" role="list">
            <li class="ph-row ph-row-new" data-newrow>
              <span class="ph-ini">{initials(h.panel.newRow[0])}</span>
              <span class="ph-row-who"><b>{h.panel.newRow[0]}</b><small>{h.panel.newRow[1]}</small></span>
              <span class="ph-chip ph-chip-ok">{h.panel.newRow[2]}</span>
            </li>
            {
              h.panel.rows.map((r, i) => (
                <li class="ph-row">
                  <span class="ph-ini">{initials(r[0])}</span>
                  <span class="ph-row-who">
                    <b>{r[0]}</b>
                    <small>{r[1]}</small>
                  </span>
                  <span class:list={["ph-chip", i === 2 ? "ph-chip-warn" : "ph-chip-ok"]}>{r[2]}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <figcaption class="ph-caption">{h.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Direção «Oficina limpa»: branco quente, tinta grafite, um verde de "aprovado" como único acento. */
  .ph {
    --ph-bg: #f6f6f3;
    --ph-bg-2: #ffffff;
    --ph-ink: #14171a;
    --ph-ink-2: #5b636b;
    --ph-ink-3: #646c74;
    --ph-line: rgb(20 23 26 / 0.09);
    --ph-line-2: rgb(20 23 26 / 0.16);
    --ph-ok: #0b8f63;
    --ph-ok-soft: #dff5ea;
    --ph-warn: #9a5b00;
    --ph-warn-soft: #fbefd7;
    --ph-glass: rgb(255 255 255 / 0.78);
    --ph-shadow: 0 1px 1px rgb(20 23 26 / 0.04), 0 10px 30px -8px rgb(20 23 26 / 0.18), 0 50px 100px -30px rgb(20 23 26 / 0.28);
    --ph-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: var(--ph-bg);
    color: var(--ph-ink);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ph {
      --ph-bg: #101316;
      --ph-bg-2: #171b1f;
      --ph-ink: #eef1f3;
      --ph-ink-2: #a3acb4;
      --ph-ink-3: #78828b;
      --ph-line: rgb(255 255 255 / 0.08);
      --ph-line-2: rgb(255 255 255 / 0.15);
      --ph-ok: #3ddc97;
      --ph-ok-soft: rgb(61 220 151 / 0.14);
      --ph-warn: #f5b94a;
      --ph-warn-soft: rgb(245 185 74 / 0.14);
      --ph-glass: rgb(28 32 37 / 0.8);
      --ph-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -8px rgb(0 0 0 / 0.5), 0 50px 100px -30px rgb(0 0 0 / 0.7);
    }
  }
  :global(:root[data-theme="dark"]) .ph {
    --ph-bg: #101316;
    --ph-bg-2: #171b1f;
    --ph-ink: #eef1f3;
    --ph-ink-2: #a3acb4;
    --ph-ink-3: #78828b;
    --ph-line: rgb(255 255 255 / 0.08);
    --ph-line-2: rgb(255 255 255 / 0.15);
    --ph-ok: #3ddc97;
    --ph-ok-soft: rgb(61 220 151 / 0.14);
    --ph-warn: #f5b94a;
    --ph-warn-soft: rgb(245 185 74 / 0.14);
    --ph-glass: rgb(28 32 37 / 0.8);
    --ph-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -8px rgb(0 0 0 / 0.5), 0 50px 100px -30px rgb(0 0 0 / 0.7);
  }

  .ph-inner {
    max-width: 82rem;
    margin: 0 auto;
    padding: 3rem max(1rem, env(safe-area-inset-right, 0px)) 4.5rem max(1rem, env(safe-area-inset-left, 0px));
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .ph-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      padding: 5rem 2rem 6.5rem;
    }
  }

  /* ---------- texto ---------- */
  .ph-copy {
    min-width: 0;
  }
  .ph-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ph-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ph-ok);
    box-shadow: 0 0 0 4px var(--ph-ok-soft);
  }
  .ph-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ph-ink-2);
    border: 1px solid var(--ph-line-2);
    border-radius: 999px;
    padding: 0.2rem 0.625rem;
    background: var(--ph-bg-2);
  }
  .ph-title {
    margin-top: 1.25rem;
    font-family: var(--oos-font-display);
    font-size: clamp(2.375rem, 4.4vw, 3.875rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 750;
    text-wrap: balance;
  }
  .ph-title span {
    display: block;
  }
  .ph-title-b {
    color: var(--ph-ink-3);
  }
  .ph-lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ph-ink-2);
    text-wrap: pretty;
  }
  .ph-ctas {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .ph-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3rem;
    padding: 0 1.375rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--ph-ease),
      border-color 0.2s;
  }
  .ph-btn:focus-visible {
    outline: 2px solid var(--ph-ok);
    outline-offset: 3px;
  }
  .ph-btn-primary {
    background: var(--ph-ink);
    color: var(--ph-bg);
    box-shadow: 0 6px 16px -6px rgb(20 23 26 / 0.45);
  }
  .ph-btn-primary:hover {
    transform: translateY(-1px);
  }
  .ph-btn-ghost {
    color: var(--ph-ink);
    border: 1px solid var(--ph-line-2);
    background: var(--ph-bg-2);
  }
  .ph-btn-ghost:hover {
    border-color: var(--ph-ink-3);
  }
  .ph-proofs {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ph-ink-2);
  }
  .ph-proofs li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ph-proofs svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: var(--ph-ok-soft);
    fill: none;
    stroke: var(--ph-ok);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ph-pro {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ph-line);
    font-size: 0.875rem;
    color: var(--ph-ink-2);
    max-width: 34rem;
  }
  .ph-pro a {
    color: var(--ph-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ph-line-2);
    text-underline-offset: 3px;
  }

  /* ---------- palco: fotografia + ecrãs vivos ---------- */
  .ph-stage {
    margin: 0;
    min-width: 0;
  }
  .ph-photo {
    position: relative;
    aspect-ratio: 1200 / 896;
    border-radius: 1.5rem;
    box-shadow: var(--ph-shadow);
    background: #d9d6d0;
  }
  .ph-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }
  .ph-caption {
    margin-top: 4.5rem;
    font-size: 0.75rem;
    color: var(--ph-ink-3);
    text-align: center;
  }
  /* Antes do script calcular a perspetiva, as superfícies não aparecem (a foto chega sozinha). */
  .ph-surface {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    overflow: hidden;
    visibility: hidden;
    backface-visibility: hidden;
  }
  .ph-photo.is-mapped .ph-surface {
    visibility: visible;
  }
  /* ecrã do tablet: 300×429 (proporção do ecrã da foto) antes do mapeamento */
  .ph-tab {
    width: 300px;
    height: 429px;
    border-radius: 10px;
    background: #fbfbfa;
    color: #14171a;
    display: flex;
    flex-direction: column;
    font-family: var(--oos-font-ui);
  }
  /* luz da janela a cair no ecrã: escurece ligeiramente para a direita, como o resto da foto */
  .ph-tab::after,
  .ph-pho::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(100deg, rgb(255 255 255 / 0.14), transparent 45%, rgb(40 36 30 / 0.07));
  }
  .ph-tab-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid rgb(20 23 26 / 0.08);
    font-size: 13px;
  }
  .ph-shop {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
  }
  .ph-shop-mark {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: #14171a;
  }
  .ph-clock {
    font-family: var(--oos-font-mono);
    color: #5b636b;
    font-variant-numeric: tabular-nums;
  }
  .ph-tab-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px 18px 26px;
  }
  .ph-qr-wrap {
    position: relative;
    width: 168px;
    height: 168px;
    display: grid;
    place-items: center;
  }
  .ph-ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .ph-ring circle {
    fill: none;
    stroke-width: 2.5;
  }
  .ph-ring-track {
    stroke: rgb(20 23 26 / 0.08);
  }
  .ph-ring-prog {
    stroke: #0b8f63;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .ph-qr {
    width: 128px;
    height: 128px;
    border-radius: 8px;
    background: #fff;
  }
  .ph-scan {
    margin-top: 14px;
    font-family: var(--oos-font-display);
    font-weight: 750;
    font-size: 21px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 13ch;
  }
  .ph-code-label {
    margin-top: 14px;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a929a;
  }
  .ph-code {
    margin-top: 2px;
    font-family: var(--oos-font-mono);
    font-weight: 600;
    font-size: 26px;
    letter-spacing: 0.22em;
    margin-right: -0.22em;
    font-variant-numeric: tabular-nums;
  }
  .ph-changes {
    margin-top: 4px;
    font-size: 11px;
    color: #5b636b;
    font-variant-numeric: tabular-nums;
  }
  .ph-toast {
    position: absolute;
    left: 50%;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px 6px 6px;
    border-radius: 999px;
    background: #14171a;
    color: #fff;
    font-size: 11px;
    font-weight: 650;
    white-space: nowrap;
    transform: translate(-50%, 40%);
    opacity: 0;
  }
  .ph-toast-ok {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #0b8f63;
  }
  .ph-toast-ok svg {
    width: 11px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ecrã do telemóvel: 180×385 (proporção do ecrã da foto) antes do mapeamento */
  .ph-pho {
    width: 180px;
    height: 385px;
    border-radius: 18px;
    background: #f1f2ef;
    color: #14171a;
    font-family: var(--oos-font-ui);
  }
  .ph-cam,
  .ph-chat {
    position: absolute;
    inset: 0;
  }
  /* visor da câmara: a parede da foto, e o tablet visto de lado com o mesmo QR */
  .ph-cam {
    background: radial-gradient(120% 80% at 70% 35%, #d8d3cb, #b3aea6 75%);
    display: grid;
    place-items: center;
    perspective: 420px;
  }
  /* o script desfaz aqui a inclinação do ecrã da foto: o QR do visor fica direito para quem vê */
  .ph-cam-fix {
    transform-origin: 50% 50%;
  }
  .ph-cam-tab {
    display: grid;
    justify-items: center;
    gap: 7px;
    width: 128px;
    padding: 12px 10px 14px;
    border-radius: 10px;
    background: #fbfbfa;
    box-shadow:
      0 0 0 6px #1c1f22,
      0 14px 24px -8px rgb(20 23 26 / 0.45);
    filter: saturate(0.95);
  }
  .ph-cam-qrbox {
    position: relative;
    width: 86px;
    height: 86px;
  }
  .ph-cam-qr {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background: #fff;
  }
  .ph-cam-line {
    width: 70%;
    height: 7px;
    border-radius: 4px;
    background: #14171a;
    opacity: 0.85;
  }
  .ph-cam-code {
    font-family: var(--oos-font-mono);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.22em;
    margin-right: -0.22em;
    color: #14171a;
  }
  .ph-reticle {
    position: absolute;
    inset: -12px;
  }
  .ph-reticle i {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 3px solid #fff;
    border-radius: 7px;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
    transition: border-color 0.25s;
  }
  .ph-reticle.is-locked i {
    border-color: #3ddc97;
  }
  .ph-reticle i:nth-child(1) {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }
  .ph-reticle i:nth-child(2) {
    top: 0;
    right: 0;
