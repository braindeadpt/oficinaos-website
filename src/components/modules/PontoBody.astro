---
// Corpo da página do Livro de Ponto (redesenho 2026-11, direção «Oficina limpa»), depois do herói.
// Ordem: problema → como funciona (3 passos com a interface) → o que o funcionário vê → reserva por SMS
// → provas → vantagens → privacidade e o que precisa → comparação → para quem → preço.
// Visuais feitos com a interface verdadeira (HTML), o QR igual ao do herói (mesma janela de 30 s).
// CSP: sem estilos inline no HTML; o único script é inline (hash).
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import { euro, fill, pricing } from "../../lib/pricing";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const p = t.pontoPage;
const m = t.modulePages.ponto;
const vars = {
  proPrice: euro(locale, pricing.pro.monthlyByok),
  days: pricing.pro.trialDays,
  pontoFrom: euro(locale, pricing.addons.ponto[0].monthly),
  pontoUpTo: pricing.addons.ponto[0].upTo,
};
const draftMatch = t.pontoHero.phone.draft.match(/^(.*#)(\d{4})$/);
const draftHead = draftMatch ? draftMatch[1] : t.pontoHero.phone.draft;
const draftCode = draftMatch ? draftMatch[2] : "";
const initials = (n: string) =>
  n
    .split(" ")
    .map((x) => x[0])
    .slice(0, 2)
    .join("");
const trustIcons = [
  // QR
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 14h3v3h-3zM18 18h3v3h-3zM14 20h1M20 14h1"/>',
  // Wi-Fi
  '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>',
  // localização
  '<path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
];
const problemIcons = [
  '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h5M10 16h5"/>',
  '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  '<rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18h2"/>',
];
---

<div class="pb" data-pb>
  <!-- ============ O problema ============ -->
  <section class="pb-sec" aria-labelledby="pb-problem">
    <div class="pb-wrap">
      <header class="pb-head">
        <p class="pb-eyebrow"><span></span>{p.problem.eyebrow}</p>
        <h2 id="pb-problem" class="pb-h2">{p.problem.title}</h2>
        <p class="pb-lead">{p.problem.lead}</p>
      </header>
      <ul class="pb-problems" role="list">
        {
          p.problem.items.map((it, i) => (
            <li class="pb-card pb-rise">
              <svg class="pb-prob-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={problemIcons[i]} />
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Como funciona ============ -->
  <section id="como-funciona" class="pb-sec pb-white" aria-labelledby="pb-steps">
    <div class="pb-wrap">
      <header class="pb-head">
        <p class="pb-eyebrow"><span></span>{p.steps.eyebrow}</p>
        <h2 id="pb-steps" class="pb-h2">{p.steps.title}</h2>
      </header>

      <ol class="pb-steps" role="list">
        <!-- 1. o link da loja -->
        <li class="pb-step">
          <div class="pb-step-text">
            <span class="pb-num" aria-hidden="true">1</span>
            <h3>{p.steps.items[0].title}</h3>
            <p>{p.steps.items[0].text}</p>
            <p class="pb-note">{p.steps.items[0].note}</p>
          </div>
          <div class="pb-visual pb-rise" aria-hidden="true">
            <div class="pb-browser">
              <div class="pb-browser-bar">
                <i></i><i></i><i></i>
                <span class="pb-url">{p.steps.link}</span>
              </div>
              <div class="pb-browser-body">
                <div class="pb-qrbox">
                  <svg class="pb-ring" viewBox="0 0 120 120">
                    <circle class="pb-ring-track" cx="60" cy="60" r="56"></circle>
                    <circle class="pb-ring-prog" cx="60" cy="60" r="56" pathLength="100" data-ring-mini></circle>
                  </svg>
                  <canvas class="pb-qr" width="232" height="232" data-qr-mini></canvas>
                </div>
                <p class="pb-qr-code"><span data-code-mini>4821</span></p>
              </div>
            </div>
            <ul class="pb-devices" role="list">
              {p.steps.devices.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        </li>

        <!-- 2. ler e enviar -->
        <li class="pb-step pb-step-rev">
          <div class="pb-step-text">
            <span class="pb-num" aria-hidden="true">2</span>
            <h3>{p.steps.items[1].title}</h3>
            <p>{p.steps.items[1].text}</p>
            <p class="pb-badge-time">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2.5M9 2h6"></path></svg>
              {p.steps.items[1].note}
            </p>
          </div>
          <div class="pb-visual pb-rise" aria-hidden="true">
            <div class="pb-chatcard">
              <div class="pb-chat-head">
                <span class="pb-avatar">OC</span>
                <span><b>{t.pontoHero.phone.contact}</b><small>{t.pontoHero.phone.contactSub}</small></span>
              </div>
              <div class="pb-chat-feed">
                <p class="pb-bub pb-bub-out">
                  {draftHead}<span data-code-draft>{draftCode}</span>
                  <span class="pb-meta">09:02 · {p.steps.sent}</span>
                </p>
                <p class="pb-bub pb-bub-in"><b>{t.pontoHero.phone.reply}</b> {t.pontoHero.phone.replySub}</p>
              </div>
            </div>
          </div>
        </li>

        <!-- 3. o painel -->
        <li class="pb-step">
          <div class="pb-step-text">
            <span class="pb-num" aria-hidden="true">3</span>
            <h3>{p.steps.items[2].title}</h3>
            <p>{p.steps.items[2].text}</p>
            <p class="pb-note">{p.steps.items[2].note}</p>
          </div>
          <div class="pb-visual pb-rise" aria-hidden="true">
            <div class="pb-dash">
              <div class="pb-dash-head">
                <span><b>{p.steps.dash.title}</b><small>{p.steps.dash.month}</small></span>
                <span class="pb-live"><i></i>3</span>
              </div>
              <ul class="pb-dash-rows" role="list">
                {
                  p.steps.dash.rows.map((r) => (
                    <li>
                      <span class="pb-ini">{initials(r[0])}</span>
                      <span class="pb-who">{r[0]}</span>
                      <span class="pb-mono">{r[1]}</span>
                      <span class="pb-mono pb-strong">{r[2]}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="pb-dash-foot">
                {
                  p.steps.dash.export.map((e) => (
                    <span class="pb-export">
                      <svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
                      {e}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ O que o funcionário vê ============ -->
  <section class="pb-sec" aria-labelledby="pb-employee">
    <div class="pb-wrap pb-split">
      <div class="pb-visual pb-rise" aria-hidden="true">
        <div class="pb-chatcard pb-chatcard-lg">
          <div class="pb-chat-head">
            <span class="pb-avatar">OC</span>
            <span><b>{t.pontoHero.phone.contact}</b><small>{t.pontoHero.phone.contactSub}</small></span>
          </div>
          <div class="pb-chat-feed">
            {p.employee.chat.map(([who, text]) => <p class:list={["pb-bub", who === "in" ? "pb-bub-out" : "pb-bub-in"]}>{text}</p>)}
            <div class="pb-quick">
              {p.employee.buttons.map((b) => <span>{b}</span>)}
            </div>
          </div>
        </div>
      </div>
      <div class="pb-split-text">
        <p class="pb-eyebrow"><span></span>{p.employee.eyebrow}</p>
        <h2 id="pb-employee" class="pb-h2">{p.employee.title}</h2>
        <p class="pb-lead">{p.employee.lead}</p>
        <dl class="pb-tips">
          {
            p.employee.tips.map((tip) => (
              <div>
                <dt>{tip.title}</dt>
                <dd>{tip.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="pb-note">{p.employee.note}</p>
      </div>
    </div>
  </section>

  <!-- ============ Reserva por SMS ============ -->
  <section class="pb-sec pb-dark" aria-labelledby="pb-sms">
    <div class="pb-wrap pb-split pb-split-sms">
      <div class="pb-split-text">
        <p class="pb-eyebrow pb-eyebrow-dark"><span></span>{p.sms.eyebrow}</p>
        <h2 id="pb-sms" class="pb-h2">{p.sms.title}</h2>
        <p class="pb-lead">{p.sms.lead}</p>
        <ul class="pb-sms-points" role="list">
          {
            p.sms.points.map((pt) => (
              <li>
                <h3>{pt.title}</h3>
                <p>{pt.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="pb-note">{p.sms.cost}</p>
      </div>
      <div class="pb-visual pb-rise" aria-hidden="true">
        <div class="pb-sms">
          <p class="pb-sms-label">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z"></path></svg>
            {p.sms.phone}
          </p>
          <div class="pb-sms-feed">
            {p.sms.chat.map(([who, text]) => <p class:list={["pb-sms-bub", who === "in" ? "pb-sms-in" : "pb-sms-out"]}>{text}</p>)}
          </div>
          <p class="pb-sms-chip">{t.pontoHero.panel.rows[2][2]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Provas ============ -->
  <section class="pb-sec pb-white" aria-labelledby="pb-trust">
    <div class="pb-wrap">
      <header class="pb-head">
        <p class="pb-eyebrow"><span></span>{p.trust.eyebrow}</p>
        <h2 id="pb-trust" class="pb-h2">{p.trust.title}</h2>
        <p class="pb-lead">{p.trust.lead}</p>
      </header>
      <ol class="pb-proofs" role="list">
        {
          p.trust.items.map((it, i) => (
            <li class="pb-card pb-rise">
              <span class="pb-proof-top">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={trustIcons[i]} />
                <span class="pb-proof-n">{i + 1}</span>
              </span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="pb-server">
        <span class="pb-server-clock" aria-hidden="true">09:40</span>
        {p.trust.serverTime}
      </p>
    </div>
  </section>

  <!-- ============ Vantagens ============ -->
  <section class="pb-sec" aria-labelledby="pb-benefits">
    <div class="pb-wrap">
      <header class="pb-head">
        <p class="pb-eyebrow"><span></span>{p.benefits.eyebrow}</p>
        <h2 id="pb-benefits" class="pb-h2">{p.benefits.title}</h2>
      </header>
      <ul class="pb-benefits" role="list">
        {
          p.benefits.items.map((b) => (
            <li class="pb-card pb-rise">
              <svg class="pb-check" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Privacidade + o que precisa ============ -->
  <section class="pb-sec pb-white" aria-labelledby="pb-needs">
    <div class="pb-wrap pb-two">
      <div class="pb-privacy pb-rise">
        <h2 class="pb-h3">{p.privacy.title}</h2>
        <ul role="list">
          {
            p.privacy.items.map((it) => (
              <li>
                <Icon name="shield" class="h-4 w-4" />
                <span>{it}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 id="pb-needs" class="pb-h3">{p.needs.title}</h2>
        <ul class="pb-needs" role="list">
          {
            p.needs.items.map((n, i) => (
              <li class="pb-rise">
                <span class:list={["pb-level", i === 0 ? "pb-level-req" : i === 1 ? "pb-level-rec" : "pb-level-sms"]}>{n.level}</span>
                <h3>{n.what}</h3>
                <p>{n.why}</p>
              </li>
            ))
          }
        </ul>
        <p class="pb-note">{p.needs.note}</p>
      </div>
    </div>
  </section>

  <!-- ============ Comparação ============ -->
  <section class="pb-sec" aria-labelledby="pb-compare">
    <div class="pb-wrap">
      <header class="pb-head">
        <h2 id="pb-compare" class="pb-h2">{p.compare.title}</h2>
      </header>
      <div class="pb-table-wrap" tabindex="0" role="region" aria-labelledby="pb-compare">
        <table class="pb-table" role="table">
          <thead role="rowgroup">
            <tr role="row">
              {
                p.compare.head.map((h, i) => (
                  <th scope="col" role="columnheader" class:list={[i === p.compare.head.length - 1 && "pb-us"]}>
                    {h}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              p.compare.rows.map((r) => (
                <tr role="row">
                  {r.map((c, i) =>
                    i === 0 ? (
                      <th scope="row" role="rowheader">
                        {c}
                      </th>
                    ) : (
                      <td role="cell" class:list={[i === r.length - 1 && "pb-us"]} data-label={p.compare.head[i]}>
                        {c}
                      </td>
                    )
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ Para quem + preço ============ -->
  <section class="pb-sec pb-white" aria-labelledby="pb-who">
    <div class="pb-wrap">
      <header class="pb-head">
        <h2 id="pb-who" class="pb-h2">{p.forWhom.title}</h2>
        <p class="pb-lead">{p.forWhom.yesTitle}</p>
      </header>
      <ul class="pb-chips" role="list">
        {p.forWhom.yes.map((y) => <li>{y}</li>)}
      </ul>
      <p class="pb-no"><b>{p.forWhom.noTitle}.</b> {p.forWhom.no}</p>

      <div id="preco" class="pb-price">
        <header class="pb-head">
          <h2 class="pb-h2">{m.pricing.title}</h2>
          <p class="pb-lead">{m.pricing.lead}</p>
        </header>
        <div class="pb-price-grid">
          <div class="pb-card pb-rise">
            <h3>{m.pricing.standaloneTitle}</h3>
            <p>{m.pricing.standaloneText}</p>
          </div>
          <div class="pb-card pb-card-accent pb-rise">
            <h3>{m.pricing.proTitle}</h3>
            <p>{fill(m.pricing.proText, vars)}</p>
            <a href={localeUrl(locale, "/pro/")} class="pb-link">
              {m.pricing.proLink}
              <Icon name="arrow" class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
        <p class="pb-note">{m.pricing.note}</p>
      </div>
    </div>
  </section>
</div>

<style>
  .pb {
    --pb-bg: #f6f6f3;
    --pb-bg-2: #ffffff;
    --pb-ink: #14171a;
    --pb-ink-2: #5b636b;
    --pb-ink-3: #8a929a;
    --pb-line: rgb(20 23 26 / 0.09);
    --pb-line-2: rgb(20 23 26 / 0.16);
    --pb-ok: #0b8f63;
    --pb-ok-soft: #dff5ea;
    --pb-warn: #9a5b00;
    --pb-warn-soft: #fbefd7;
    --pb-info: #2f5bd3;
    --pb-info-soft: #e7edfc;
    --pb-shadow: 0 1px 1px rgb(20 23 26 / 0.04), 0 10px 30px -10px rgb(20 23 26 / 0.16);
    --pb-dark: #14171a;
    --pb-dark-2: #1d2125;
    --pb-dark-ink: #eef1f3;
    --pb-dark-ink-2: #a3acb4;
    color: var(--pb-ink);
    background: var(--pb-bg);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .pb {
      --pb-bg: #101316;
      --pb-bg-2: #171b1f;
      --pb-ink: #eef1f3;
      --pb-ink-2: #a3acb4;
      --pb-ink-3: #78828b;
      --pb-line: rgb(255 255 255 / 0.08);
      --pb-line-2: rgb(255 255 255 / 0.15);
      --pb-ok: #3ddc97;
      --pb-ok-soft: rgb(61 220 151 / 0.14);
      --pb-warn: #f5b94a;
      --pb-warn-soft: rgb(245 185 74 / 0.14);
      --pb-info: #8fb0ff;
      --pb-info-soft: rgb(143 176 255 / 0.14);
      --pb-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -10px rgb(0 0 0 / 0.5);
      --pb-dark: #0b0d0f;
      --pb-dark-2: #171b1f;
    }
  }
  :global(:root[data-theme="dark"]) .pb {
    --pb-bg: #101316;
    --pb-bg-2: #171b1f;
    --pb-ink: #eef1f3;
    --pb-ink-2: #a3acb4;
    --pb-ink-3: #78828b;
    --pb-line: rgb(255 255 255 / 0.08);
    --pb-line-2: rgb(255 255 255 / 0.15);
    --pb-ok: #3ddc97;
    --pb-ok-soft: rgb(61 220 151 / 0.14);
    --pb-warn: #f5b94a;
    --pb-warn-soft: rgb(245 185 74 / 0.14);
    --pb-info: #8fb0ff;
    --pb-info-soft: rgb(143 176 255 / 0.14);
    --pb-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -10px rgb(0 0 0 / 0.5);
    --pb-dark: #0b0d0f;
    --pb-dark-2: #171b1f;
  }

  /* ---------- estrutura ---------- */
  .pb-sec {
    padding-block: 5.5rem;
  }
  @media (min-width: 64rem) {
    .pb-sec {
      padding-block: 7.5rem;
    }
  }
  .pb-white {
    background: var(--pb-bg-2);
  }
  .pb-wrap {
    max-width: 76rem;
    margin: 0 auto;
    padding-left: max(1rem, env(safe-area-inset-left, 0px));
    padding-right: max(1rem, env(safe-area-inset-right, 0px));
  }
  @media (min-width: 64rem) {
    .pb-wrap {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  .pb-head {
    max-width: 46rem;
  }
  .pb-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pb-ink-2);
  }
  .pb-eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pb-ok);
  }
  .pb-h2 {
    margin-top: 0.875rem;
    font-family: var(--oos-font-display);
    font-size: clamp(1.875rem, 3.6vw, 2.875rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 750;
    text-wrap: balance;
  }
  .pb-h3 {
    font-family: var(--oos-font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 750;
  }
  .pb-lead {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--pb-ink-2);
    text-wrap: pretty;
  }
  .pb-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--pb-ink-3);
  }
  .pb-card {
    border-radius: 1.25rem;
    padding: 1.5rem;
    background: var(--pb-bg-2);
    box-shadow: var(--pb-shadow), 0 0 0 1px var(--pb-line);
  }
  .pb-white .pb-card {
    background: var(--pb-bg);
    box-shadow: 0 0 0 1px var(--pb-line);
  }
  .pb-card h3 {
    font-family: var(--oos-font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .pb-card p {
    margin-top: 0.5rem;
    font-size: 0.9875rem;
    line-height: 1.55;
    color: var(--pb-ink-2);
  }
  .pb-mono {
    font-family: var(--oos-font-mono);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- problema ---------- */
  .pb-problems {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .pb-problems {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pb-prob-ico {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.45rem;
    border-radius: 0.75rem;
    background: var(--pb-warn-soft);
    fill: none;
    stroke: var(--pb-warn);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 1.25rem;
  }

  /* ---------- passos ---------- */
  .pb-steps {
    margin-top: 3.5rem;
    display: grid;
    gap: 5rem;
  }
  .pb-step {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .pb-step {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .pb-step-rev .pb-step-text {
      order: 2;
    }
  }
  .pb-step-text {
    min-width: 0;
    max-width: 30rem;
  }
  .pb-num {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--pb-ink);
    color: var(--pb-bg-2);
    font-family: var(--oos-font-mono);
    font-weight: 600;
  }
  .pb-step-text h3 {
    margin-top: 1.25rem;
    font-family: var(--oos-font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 750;
    text-wrap: balance;
  }
  .pb-step-text > p:not(.pb-note):not(.pb-badge-time) {
    margin-top: 0.875rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--pb-ink-2);
  }
  .pb-badge-time {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    background: var(--pb-ok-soft);
    color: var(--pb-ok);
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .pb-badge-time svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .pb-visual {
    min-width: 0;
    display: grid;
    justify-items: center;
    padding: 2.25rem 1.25rem;
    border-radius: 1.75rem;
    background:
      radial-gradient(80% 70% at 50% 0%, var(--pb-ok-soft), transparent 70%),
      var(--pb-bg);
    box-shadow: 0 0 0 1px var(--pb-line);
  }

  /* visual 1: navegador com o QR */
  .pb-browser {
    width: min(21rem, 100%);
    border-radius: 1rem;
    background: var(--pb-bg-2);
    box-shadow: var(--pb-shadow), 0 0 0 1px var(--pb-line);
    overflow: hidden;
  }
  .pb-browser-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--pb-line);
  }
  .pb-browser-bar i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--pb-line-2);
  }
  .pb-url {
    margin-left: 0.5rem;
    flex: 1;
    min-width: 0;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--pb-bg);
    font-family: var(--oos-font-mono);
    font-size: 0.6875rem;
    color: var(--pb-ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pb-browser-body {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1rem 1.25rem;
  }
  .pb-qrbox {
    position: relative;
    width: 9.5rem;
    height: 9.5rem;
    display: grid;
    place-items: center;
  }
  .pb-ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .pb-ring circle {
    fill: none;
    stroke-width: 2.5;
  }
  .pb-ring-track {
    stroke: var(--pb-line);
  }
  .pb-ring-prog {
    stroke: var(--pb-ok);
    stroke-linecap: round;
    stroke-dasharray: 100;
  }
  .pb-qr {
    width: 7.25rem;
    height: 7.25rem;
    border-radius: 0.5rem;
    background: #fff;
  }
  .pb-qr-code {
    font-family: var(--oos-font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    margin-right: -0.22em;
  }
  .pb-devices {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .pb-devices li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--pb-bg-2);
    box-shadow: 0 0 0 1px var(--pb-line-2);
    font-size: 0.8125rem;
    color: var(--pb-ink-2);
  }

  /* visual 2: conversa */
  .pb-chatcard {
    width: min(19rem, 100%);
    border-radius: 1.5rem;
    background: var(--pb-bg-2);
    box-shadow: var(--pb-shadow), 0 0 0 1px var(--pb-line);
    overflow: hidden;
  }
  .pb-chatcard-lg {
    width: min(22rem, 100%);
  }
  .pb-chat-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--pb-line);
  }
  .pb-chat-head > span:last-child {
    display: grid;
    line-height: 1.2;
  }
  .pb-chat-head b {
    font-size: 0.875rem;
  }
  .pb-chat-head small {
    font-size: 0.75rem;
    color: var(--pb-ink-3);
  }
  .pb-avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--pb-ink);
    color: var(--pb-bg-2);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .pb-chat-feed {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--pb-bg);
  }
  .pb-bub {
    max-width: 88%;
    padding: 0.55rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .pb-bub-out {
    justify-self: end;
    background: var(--pb-ok-soft);
    border-bottom-right-radius: 0.3rem;
    font-weight: 600;
  }
  .pb-bub-in {
    justify-self: start;
    background: var(--pb-bg-2);
    border-bottom-left-radius: 0.3rem;
    box-shadow: 0 0 0 1px var(--pb-line);
  }
  .pb-bub-in b {
    color: var(--pb-ok);
  }
  .pb-meta {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--pb-ink-3);
    text-align: right;
  }
  .pb-quick {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .pb-quick span {
    flex: 1;
    text-align: center;
    padding: 0.55rem;
    border-radius: 0.75rem;
    background: var(--pb-bg-2);
    box-shadow: 0 0 0 1px var(--pb-line-2);
    color: var(--pb-ok);
    font-weight: 650;
    font-size: 0.875rem;
  }

  /* visual 3: painel */
  .pb-dash {
    width: min(23rem, 100%);
    border-radius: 1.25rem;
    background: var(--pb-bg-2);
    box-shadow: var(--pb-shadow), 0 0 0 1px var(--pb-line);
    padding: 1rem;
  }
  .pb-dash-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    padding-bottom: 0.75rem;
  }
  .pb-dash-head > span:first-child {
    display: grid;
    line-height: 1.25;
  }
  .pb-dash-head small {
    font-size: 0.75rem;
    color: var(--pb-ink-3);
  }
  .pb-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--oos-font-mono);
    font-weight: 600;
  }
  .pb-live i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pb-ok);
    box-shadow: 0 0 0 3px var(--pb-ok-soft);
  }
  .pb-dash-rows li {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--pb-line);
    font-size: 0.875rem;
  }
  .pb-ini {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--pb-ok-soft);
    color: var(--pb-ok);
    font-size: 0.625rem;
    font-weight: 700;
  }
  .pb-who {
    min-width: 0;
    font-weight: 600;
  }
  .pb-dash-rows .pb-mono {
    font-size: 0.8125rem;
    color: var(--pb-ink-2);
  }
  .pb-dash-rows .pb-strong {
    color: var(--pb-ink);
    font-weight: 600;
  }
  .pb-dash-foot {
    display: flex;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pb-line);
  }
  .pb-export {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--pb-ink);
    color: var(--pb-bg-2);
    font-size: 0.75rem;
    font-weight: 650;
  }
  .pb-export svg {
    width: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- duas colunas (funcionário, SMS) ---------- */
  .pb-split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .pb-split {
      grid-template-columns: 1fr 1fr;
      gap: 4.5rem;
    }
  }
  .pb-split-text {
    min-width: 0;
  }
  .pb-tips {
    margin-top: 2rem;
    display: grid;
    gap: 0.25rem;
  }
  .pb-tips div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--pb-line);
  }
  .pb-tips dt {
    font-weight: 650;
  }
  .pb-tips dd {
    margin: 0;
    color: var(--pb-ink-2);
  }
  @media (max-width: 30rem) {
    .pb-tips div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  /* ---------- SMS (faixa escura) ---------- */
  .pb-dark {
    background: var(--pb-dark);
    color: var(--pb-dark-ink);
  }
  .pb-dark .pb-lead,
  .pb-dark .pb-note,
  .pb-dark .pb-sms-points p {
    color: var(--pb-dark-ink-2);
  }
  .pb-eyebrow-dark {
    color: var(--pb-dark-ink-2);
  }
  .pb-eyebrow-dark span {
    background: #3ddc97;
  }
  .pb-sms-points {
    margin-top: 2.25rem;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .pb-sms-points {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pb-sms-points li {
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .pb-sms-points h3 {
    font-weight: 700;
    font-size: 1rem;
  }
  .pb-sms-points p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .pb-split-sms .pb-visual {
    background:
      radial-gradient(80% 70% at 50% 0%, rgb(61 220 151 / 0.14), transparent 70%),
      var(--pb-dark-2);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .pb-sms {
    width: min(20rem, 100%);
    border-radius: 1.5rem;
    background: #f2f2f4;
    color: #14171a;
    padding: 1rem;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .pb-sms-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 650;
    color: #5b636b;
    padding-bottom: 0.75rem;
  }
  .pb-sms-label svg {
    width: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .pb-sms-feed {
    display: grid;
    gap: 0.5rem;
  }
  .pb-sms-bub {
    max-width: 85%;
    padding: 0.55rem 0.8rem;
    border-radius: 1.1rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .pb-sms-in {
    justify-self: end;
    background: #34c759;
    color: #fff;
    font-weight: 600;
    font-family: var(--oos-font-mono);
    letter-spacing: 0.04em;
  }
  .pb-sms-out {
    justify-self: start;
    background: #e5e5ea;
  }
  .pb-sms-chip {
    margin-top: 0.875rem;
    justify-self: start;
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: #fbefd7;
    color: #9a5b00;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* ---------- provas ---------- */
  .pb-proofs {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .pb-proofs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .pb-proof-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .pb-proof-top svg {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
    background: var(--pb-ok-soft);
    fill: none;
    stroke: var(--pb-ok);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pb-proof-n {
    font-family: var(--oos-font-mono);
    font-size: 0.8125rem;
    color: var(--pb-ink-3);
  }
  .pb-server {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    border-radius: 1.25rem;
    background: var(--pb-ink);
    color: var(--pb-bg-2);
    font-size: 1rem;
    line-height: 1.5;
  }
  .pb-server-clock {
    flex: none;
    font-family: var(--oos-font-mono);
    font-weight: 600;
    font-size: 1.125rem;
    padding: 0.35rem 0.7rem;
    border-radius: 0.6rem;
    background: rgb(255 255 255 / 0.1);
  }

  /* ---------- vantagens ---------- */
  .pb-benefits {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .pb-benefits {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .pb-benefits {
      grid-template-columns: repeat(3, 1fr);
    }
    .pb-benefits li:nth-child(5),
    .pb-benefits li:nth-child(7) {
      grid-column: span 2;
    }
  }
  .pb-check {
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.35rem;
    border-radius: 50%;
    background: var(--pb-ok-soft);
    fill: none;
    stroke: var(--pb-ok);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 1rem;
  }

  /* ---------- privacidade + o que precisa ---------- */
  .pb-two {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 56rem) {
    .pb-two {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }
  .pb-privacy {
    align-self: start;
    border-radius: 1.5rem;
    padding: 2rem;
    background: var(--pb-bg);
    box-shadow: 0 0 0 1px var(--pb-line);
  }
  .pb-privacy ul {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  .pb-privacy li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    line-height: 1.55;
    color: var(--pb-ink-2);
  }
  .pb-privacy li :global(svg) {
    margin-top: 0.2rem;
    color: var(--pb-ok);
  }
  .pb-needs {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .pb-needs li {
    border-radius: 1.25rem;
    padding: 1.25rem 1.375rem;
    background: var(--pb-bg);
    box-shadow: 0 0 0 1px var(--pb-line);
  }
  .pb-needs h3 {
    margin-top: 0.625rem;
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .pb-needs p {
    margin-top: 0.3rem;
    color: var(--pb-ink-2);
    line-height: 1.55;
    font-size: 0.9375rem;
  }
  .pb-level {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .pb-level-req {
    background: var(--pb-ink);
    color: var(--pb-bg-2);
  }
  .pb-level-rec {
    background: var(--pb-ok-soft);
    color: var(--pb-ok);
  }
  .pb-level-sms {
    background: var(--pb-info-soft);
    color: var(--pb-info);
  }

  /* ---------- comparação ---------- */
  .pb-table-wrap {
    margin-top: 2.5rem;
    overflow-x: auto;
    border-radius: 1.25rem;
    background: var(--pb-bg-2);
    box-shadow: 0 0 0 1px var(--pb-line);
  }
  .pb-table-wrap:focus-visible {
    outline: 2px solid var(--pb-ok);
    outline-offset: 3px;
  }
  .pb-table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .pb-table th,
  .pb-table td {
    padding: 0.95rem 1.1rem;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--pb-line);
  }
  .pb-table thead th {
    border-top: 0;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--pb-ink-2);
  }
  .pb-table tbody th {
    font-weight: 650;
  }
  .pb-table td {
    color: var(--pb-ink-2);
  }
  .pb-table .pb-us {
    background: var(--pb-ok-soft);
    color: var(--pb-ink);
    font-weight: 650;
  }
  .pb-table thead .pb-us {
    color: var(--pb-ok);
  }

  /* em ecrãs estreitos, cada linha passa a cartão (sem scroll lateral) */
  @media (max-width: 47.99rem) {
    .pb-table-wrap {
      overflow: visible;
      background: none;
      box-shadow: none;
    }
    .pb-table {
      min-width: 0;
    }
    .pb-table thead {
      display: none;
    }
    .pb-table,
    .pb-table tbody,
    .pb-table tr,
    .pb-table th,
    .pb-table td {
      display: block;
    }
    .pb-table tr {
      margin-bottom: 0.75rem;
      border-radius: 1.125rem;
      overflow: hidden;
      background: var(--pb-bg-2);
      box-shadow: 0 0 0 1px var(--pb-line);
    }
    .pb-table tbody th {
      border-top: 0;
      padding-bottom: 0.25rem;
      font-size: 1rem;
    }
    .pb-table td {
      display: grid;
      grid-template-columns: 8.5rem 1fr;
      gap: 0.75rem;
      padding-block: 0.55rem;
    }
    .pb-table td::before {
      content: attr(data-label);
      color: var(--pb-ink-3);
      font-weight: 500;
    }
    .pb-table td.pb-us::before {
      color: var(--pb-ok);
      font-weight: 700;
    }
  }

  /* ---------- para quem + preço ---------- */
  .pb-chips {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pb-chips li {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--pb-bg);
    box-shadow: 0 0 0 1px var(--pb-line-2);
    font-weight: 550;
  }
  .pb-no {
    margin-top: 1.5rem;
    max-width: 46rem;
    color: var(--pb-ink-2);
    line-height: 1.6;
  }
  .pb-no b {
    color: var(--pb-ink);
  }
  .pb-price {
    margin-top: 6rem;
  }
  .pb-price-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .pb-price-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pb-card-accent {
    box-shadow: 0 0 0 2px var(--pb-ok) !important;
  }
  .pb-link {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--pb-ink);
    text-decoration: underline;
    text-decoration-color: var(--pb-line-2);
    text-underline-offset: 4px;
  }
  .pb-link:hover {
    text-decoration-color: currentColor;
  }

  /* Formulário da lista de espera (componente partilhado): só as cores, na linguagem desta página. */
  :global(.pb-wait) {
    --oos-color-primary: #14171a;
    --color-primary: #14171a;
    --oos-color-primary-hover: #2a2f34;
    --color-primary-hover: #2a2f34;
    --oos-color-on-primary: #ffffff;
    --color-on-primary: #ffffff;
    --oos-color-link: #14171a;
    --color-link: #14171a;
    --oos-color-focus: #0b8f63;
    --color-focus: #0b8f63;
    background: #f6f6f3;
  }
