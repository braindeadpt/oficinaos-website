---
// Herói do Atendimento IA (redesenho 2026-11, direção «Oficina limpa»).
// Fotografia gerada por IA (café-pastelaria, ecrãs de frente) com a interface verdadeira colada nos
// ecrãs: no portátil, a consola da empresa; no telemóvel, a mesma conversa vista pelo cliente. São
// 22:41 e a loja está fechada: o assistente responde e passa a encomenda à equipa. Mapeamento por
// homografia (matrix3d) a partir dos cantos medidos na foto (recorte de 920×570). CSP: sem estilos inline no
// HTML; o script entra por hash. Sem JS ou com «reduzir movimento» fica o estado final.
import type { Copy } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";
import { localeUrl } from "../../i18n/utils";
import Icon from "../Icon.astro";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const m = t.modulePages.atendimento;
const h = t.atendimentoHero;
const c = h.console;
const base = import.meta.env.BASE_URL;
// A foto base já traz a conversa desenhada nos ecrãs (estado final, na língua da página): é o que
// vê quem não tem JavaScript; as camadas vivas cobrem-na por cima.
const img = locale === "pt" ? "atendimento-hero" : `atendimento-hero-${locale}`;
const initials = (n: string) =>
  n
    .replace(/[^\p{L} ]/gu, "")
    .trim()
    .split(" ")
    .map((x) => x[0])
    .slice(0, 2)
    .join("") || "#";
---

<section class="ah" aria-labelledby="ah-title" data-ah data-static>
  <div class="ah-inner">
    <div class="ah-copy">
      <p class="ah-eyebrow">
        <span class="ah-dot" aria-hidden="true"></span>
        {m.hero.label}
        <span class="ah-badge">{m.hero.badge}</span>
      </p>
      <h1 id="ah-title" class="ah-title">
        <span>{h.titleA}</span>
        <span class="ah-title-b">{h.titleB}</span>
      </h1>
      <p class="ah-lead">{m.hero.subtitle}</p>
      <div class="ah-ctas">
        <a href="#beta" class="ah-btn ah-btn-primary">
          {m.hero.cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="#como-funciona" class="ah-btn ah-btn-ghost">{m.hero.ctaSecondary}</a>
      </div>
      <ul class="ah-proofs" role="list">
        {
          h.proofs.map((p) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
      <p class="ah-pro">
        {m.hero.proNote}
        <a href={localeUrl(locale, "/pro/")}>{m.hero.proLink}</a>
      </p>
    </div>

    <figure class="ah-stage">
      <div class="ah-photo" data-photo>
        <img
          class="ah-img"
          src={`${base}images/${img}.webp`}
          srcset={`${base}images/${img}-800.webp 690w, ${base}images/${img}.webp 920w`}
          sizes="(min-width: 64rem) 50vw, 100vw"
          width="920"
          height="570"
          alt={h.caption}
          fetchpriority="high"
          decoding="async"
        />

        <!-- Consola da empresa no portátil -->
        <div class="ah-surface ah-lap" data-quad="382,94 831,94 382,386 831,386" aria-hidden="true">
          <header class="ah-lap-bar">
            <span class="ah-brand"><span class="ah-brand-mark"></span>{c.shop}</span>
            <span class="ah-status"><i></i>{c.status}</span>
          </header>
          <div class="ah-lap-body">
            <aside class="ah-inbox">
              <p class="ah-inbox-title">{c.inbox}</p>
              <ul role="list">
                {
                  c.list.map((r, i) => (
                    <li class:list={["ah-conv", i === 0 && "is-active"]}>
                      <span class="ah-conv-ini">{initials(r[0])}</span>
                      <span class="ah-conv-text">
                        <b>{r[0]}</b>
                        <small>{r[1]}</small>
                      </span>
                      <span class="ah-conv-time">{r[2]}</span>
                    </li>
                  ))
                }
              </ul>
            </aside>
            <div class="ah-thread">
              <p class="ah-thread-head">
                <b>{c.list[0][0]}</b>
                <span>WhatsApp</span>
              </p>
              <div class="ah-feed">
                {
                  h.chat.map(([who, text], i) => (
                    <p class:list={["ah-msg", who === "in" ? "ah-msg-in" : "ah-msg-out"]} data-lmsg={i}>
                      {who === "out" && <span class="ah-msg-who">{c.assistant}</span>}
                      {text}
                    </p>
                  ))
                }
                <p class="ah-typing" data-ltyping><i></i><i></i><i></i></p>
              </div>
              <div class="ah-handoff" data-handoff>
                <span class="ah-handoff-ico">
                  <svg viewBox="0 0 16 16"><path d="M3 8h8M8 4.5 11.5 8 8 11.5"></path></svg>
                </span>
                <span class="ah-handoff-text">
                  <small>{c.handoffTitle}</small>
                  <b>{c.handoff}</b>
                </span>
                <span class="ah-handoff-tag">{c.handoffTag}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- A mesma conversa no telemóvel do cliente -->
        <div class="ah-surface ah-pho" data-quad="109.8,185.7 218,191 106.3,416.4 218,415.3" aria-hidden="true">
          <div class="ah-pho-head">
            <span class="ah-pho-ava">CC</span>
            <b>{c.shop}</b>
          </div>
          <div class="ah-pho-feed">
            {
              h.chat.map(([who, text], i) => (
                <p class:list={["ah-pmsg", who === "in" ? "ah-pmsg-me" : "ah-pmsg-them"]} data-pmsg={i}>
                  {text}
                </p>
              ))
            }
            <p class="ah-ptyping" data-ptyping><i></i><i></i><i></i></p>
          </div>
        </div>

        <!-- Pausar/retomar a demonstração (WCAG 2.2.2): só aparece quando há animação -->
        <button class="ah-pause" type="button" data-pause aria-label={t.pontoHero.demoPause} data-label-pause={t.pontoHero.demoPause} data-label-play={t.pontoHero.demoPlay}>
          <svg class="ah-pause-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9M11 3.5v9"></path></svg>
          <svg class="ah-play-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z"></path></svg>
        </button>

        <!-- Resumo do dia -->
        <div class="ah-panel" aria-hidden="true">
          <p class="ah-panel-title">{h.panel.title}</p>
          <dl>
            {
              h.panel.rows.map((r, i) => (
                <div>
                  <dt>{r[0]}</dt>
                  <dd data-stat={i}>{r[1]}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <figcaption class="ah-caption">{h.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .ah {
    --ah-bg: #f6f6f3;
    --ah-bg-2: #ffffff;
    --ah-ink: #14171a;
    --ah-ink-2: #5b636b;
    --ah-ink-3: #8a929a;
    --ah-line: rgb(20 23 26 / 0.09);
    --ah-line-2: rgb(20 23 26 / 0.16);
    --ah-ok: #0b8f63;
    --ah-ok-soft: #dff5ea;
    --ah-glass: rgb(255 255 255 / 0.8);
    --ah-shadow: 0 1px 1px rgb(20 23 26 / 0.04), 0 10px 30px -8px rgb(20 23 26 / 0.18), 0 50px 100px -30px rgb(20 23 26 / 0.28);
    --ah-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    background: var(--ah-bg);
    color: var(--ah-ink);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ah {
      --ah-bg: #101316;
      --ah-bg-2: #171b1f;
      --ah-ink: #eef1f3;
      --ah-ink-2: #a3acb4;
      --ah-ink-3: #78828b;
      --ah-line: rgb(255 255 255 / 0.08);
      --ah-line-2: rgb(255 255 255 / 0.15);
      --ah-ok: #3ddc97;
      --ah-ok-soft: rgb(61 220 151 / 0.14);
      --ah-glass: rgb(28 32 37 / 0.82);
      --ah-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -8px rgb(0 0 0 / 0.5), 0 50px 100px -30px rgb(0 0 0 / 0.7);
    }
  }
  :global(:root[data-theme="dark"]) .ah {
    --ah-bg: #101316;
    --ah-bg-2: #171b1f;
    --ah-ink: #eef1f3;
    --ah-ink-2: #a3acb4;
    --ah-ink-3: #78828b;
    --ah-line: rgb(255 255 255 / 0.08);
    --ah-line-2: rgb(255 255 255 / 0.15);
    --ah-ok: #3ddc97;
    --ah-ok-soft: rgb(61 220 151 / 0.14);
    --ah-glass: rgb(28 32 37 / 0.82);
    --ah-shadow: 0 1px 1px rgb(0 0 0 / 0.3), 0 10px 30px -8px rgb(0 0 0 / 0.5), 0 50px 100px -30px rgb(0 0 0 / 0.7);
  }

  .ah-inner {
    max-width: 82rem;
    margin: 0 auto;
    padding: 3rem max(1rem, env(safe-area-inset-right, 0px)) 4.5rem max(1rem, env(safe-area-inset-left, 0px));
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .ah-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      padding: 5rem 2rem 6.5rem;
    }
  }

  /* ---------- texto (igual ao herói do Livro de Ponto) ---------- */
  .ah-copy {
    min-width: 0;
  }
  .ah-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ah-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ah-ok);
    box-shadow: 0 0 0 4px var(--ah-ok-soft);
  }
  .ah-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ah-ink-2);
    border: 1px solid var(--ah-line-2);
    border-radius: 999px;
    padding: 0.2rem 0.625rem;
    background: var(--ah-bg-2);
  }
  .ah-title {
    margin-top: 1.25rem;
    font-family: var(--oos-font-display);
    font-size: clamp(2.125rem, 3.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 750;
    text-wrap: balance;
  }
  .ah-title span {
    display: block;
  }
  .ah-title-b {
    color: var(--ah-ink-3);
  }
  .ah-lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ah-ink-2);
    text-wrap: pretty;
  }
  .ah-ctas {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .ah-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3rem;
    padding: 0 1.375rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--ah-ease),
      border-color 0.2s;
  }
  .ah-btn:focus-visible {
    outline: 2px solid var(--ah-ok);
    outline-offset: 3px;
  }
  .ah-btn-primary {
    background: var(--ah-ink);
    color: var(--ah-bg);
    box-shadow: 0 6px 16px -6px rgb(20 23 26 / 0.45);
  }
  .ah-btn-primary:hover {
    transform: translateY(-1px);
  }
  .ah-btn-ghost {
    color: var(--ah-ink);
    border: 1px solid var(--ah-line-2);
    background: var(--ah-bg-2);
  }
  .ah-btn-ghost:hover {
    border-color: var(--ah-ink-3);
  }
  .ah-proofs {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--ah-ink-2);
  }
  .ah-proofs li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ah-proofs svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: var(--ah-ok-soft);
    fill: none;
    stroke: var(--ah-ok);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ah-pro {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ah-line);
    font-size: 0.875rem;
    color: var(--ah-ink-2);
    max-width: 34rem;
  }
  .ah-pro a {
    color: var(--ah-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ah-line-2);
    text-underline-offset: 3px;
  }

  /* ---------- palco ---------- */
  .ah-stage {
    margin: 0;
    min-width: 0;
  }
  .ah-photo {
    position: relative;
    aspect-ratio: 920 / 570;
    border-radius: 1.5rem;
    box-shadow: var(--ah-shadow);
    background: #d8cfc4;
  }
  .ah-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }
  .ah-caption {
    margin-top: 5.5rem;
    font-size: 0.75rem;
    color: var(--ah-ink-3);
    text-align: center;
  }
  .ah-surface {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    overflow: hidden;
    visibility: hidden;
    backface-visibility: hidden;
    font-family: var(--oos-font-ui);
    color: #14171a;
  }
  .ah-photo.is-mapped .ah-surface {
    visibility: visible;
  }

  /* consola (portátil): 400×260 antes do mapeamento */
  .ah-lap {
    width: 400px;
    height: 260px;
    background: #fbfbfa;
    display: flex;
    flex-direction: column;
  }
  .ah-lap-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-bottom: 1px solid rgb(20 23 26 / 0.08);
    font-size: 11px;
  }
  .ah-brand {
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: 650;
  }
  .ah-brand-mark {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: #14171a;
  }
  .ah-status {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #dff5ea;
    color: #0b7a55;
    font-weight: 650;
    font-size: 10px;
  }
  .ah-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0b8f63;
  }
  .ah-lap-body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 112px 1fr;
    grid-template-rows: minmax(0, 1fr);
  }
  .ah-inbox {
    border-right: 1px solid rgb(20 23 26 / 0.08);
    padding: 8px 6px;
    background: #f4f4f1;
  }
  .ah-inbox-title {
    padding: 0 6px 8px;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a929a;
  }
  .ah-conv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px;
    align-items: center;
    padding: 6px 5px;
    border-radius: 8px;
  }
  .ah-conv.is-active {
    background: #fff;
    box-shadow: 0 0 0 1px rgb(20 23 26 / 0.07);
  }
  .ah-conv-ini {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e6e7e3;
    font-size: 8px;
    font-weight: 700;
    color: #5b636b;
  }
  .ah-conv.is-active .ah-conv-ini {
    background: #14171a;
    color: #fff;
  }
  .ah-conv-text {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .ah-conv-text b {
    font-size: 10.5px;
  }
  .ah-conv-text small {
    font-size: 9px;
    color: #8a929a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ah-conv-time {
    display: none;
    font-size: 8.5px;
    color: #8a929a;
    font-family: var(--oos-font-mono);
  }
  .ah-thread {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .ah-thread-head {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 7px 10px;
    border-bottom: 1px solid rgb(20 23 26 / 0.06);
    font-size: 11px;
  }
  .ah-thread-head span {
    font-size: 9.5px;
    color: #8a929a;
  }
  /* como numa app de conversas: as mensagens novas ficam em baixo e as antigas sobem */
  .ah-feed {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 5px;
    padding: 8px 10px 50px;
  }
  .ah-msg {
    max-width: 86%;
    padding: 5px 8px;
    border-radius: 9px;
    font-size: 9.5px;
    line-height: 1.4;
  }
  .ah-msg-in {
    align-self: flex-start;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(20 23 26 / 0.08);
    border-bottom-left-radius: 3px;
  }
  .ah-msg-out {
    align-self: flex-end;
    background: #dff5ea;
    border-bottom-right-radius: 3px;
  }
  .ah-msg-who {
    display: block;
    font-size: 8.5px;
    font-weight: 700;
    color: #0b7a55;
    margin-bottom: 1px;
  }
  .ah-typing,
  .ah-ptyping {
    display: flex;
    gap: 3px;
    padding: 7px 9px;
    border-radius: 10px;
    background: #dff5ea;
    align-self: flex-end;
  }
  .ah-typing i,
  .ah-ptyping i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #0b8f63;
    opacity: 0.6;
  }
  .ah-handoff {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 8px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border-radius: 10px;
    background: #14171a;
    color: #fff;
    box-shadow: 0 8px 20px -8px rgb(20 23 26 / 0.5);
  }
  .ah-handoff-ico {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #3ddc97;
  }
  .ah-handoff-ico svg {
    width: 11px;
    fill: none;
    stroke: #14171a;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ah-handoff-text {
    display: grid;
    line-height: 1.25;
    min-width: 0;
  }
  .ah-handoff-text small {
    font-size: 8.5px;
    color: #a3acb4;
  }
  .ah-handoff-text b {
    font-size: 10.5px;
  }
  .ah-handoff-tag {
    font-size: 8.5px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
  }

  /* telemóvel do cliente: 180×376 antes do mapeamento */
  .ah-pho {
    width: 180px;
    height: 376px;
    border-radius: 18px;
    background: #efeae2;
    display: flex;
    flex-direction: column;
  }
  .ah-pho-head {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 30px 10px 8px;
    background: #fff;
    border-bottom: 1px solid rgb(20 23 26 / 0.07);
    font-size: 11px;
  }
  .ah-pho-ava {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #14171a;
    color: #fff;
    font-size: 8px;
    font-weight: 700;
  }
  .ah-pho-feed {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 10px 8px 14px;
  }
  .ah-pmsg {
    max-width: 86%;
    padding: 6px 8px;
    border-radius: 10px;
    font-size: 10px;
    line-height: 1.35;
  }
  .ah-pmsg-me {
    align-self: flex-end;
    background: #d9fdd3;
    border-bottom-right-radius: 3px;
  }
  .ah-pmsg-them {
    align-self: flex-start;
    background: #fff;
    border-bottom-left-radius: 3px;
  }
  .ah-ptyping {
    align-self: flex-start;
    background: #fff;
  }
  .ah-ptyping i {
    background: #8a929a;
  }

  /* resumo do dia, em vidro */
  .ah-panel {
    position: absolute;
    left: -2.75rem;
    bottom: -4.25rem;
    width: min(15.5rem, 46%);
    padding: 0.875rem 1rem;
    border-radius: 1.125rem;
    background: var(--ah-glass);
    color: var(--ah-ink);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      var(--ah-shadow),
      0 0 0 1px var(--ah-line);
  }
  .ah-panel-title {
    font-size: 0.75rem;
    font-weight: 700;
    padding-bottom: 0.5rem;
  }
  .ah-panel dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--ah-line);
    font-size: 0.75rem;
  }
  .ah-panel dt {
    color: var(--ah-ink-2);
  }
  .ah-panel dd {
    margin: 0;
    font-family: var(--oos-font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ah-panel dl div:last-child dd {
    color: var(--ah-ok);
  }

  /* estados da animação: antes de começar fica tudo escondido; sem JS fica o estado final */
  .ah-msg,
  .ah-pmsg,
  .ah-typing,
  .ah-ptyping,
  .ah-handoff {
    opacity: 0;
  }
  .ah[data-static] .ah-msg,
  .ah[data-static] .ah-pmsg,
  .ah[data-static] .ah-handoff {
    opacity: 1;
  }
  /* durante a animação, o que ainda não apareceu sai do fluxo: senão empurrava a 1.ª mensagem para fora */
  .ah:not([data-static]) .ah-msg:not(.is-on),
  .ah:not([data-static]) .ah-pmsg:not(.is-on),
  .ah-typing:not(.is-on),
  .ah-ptyping:not(.is-on) {
    display: none;
  }

  .ah-pause {
    position: absolute;
    right: 0.875rem;
    top: 0.875rem;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: rgb(20 23 26 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
  }
  .ah-pause:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .ah-pause svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ah-play-i,
  .ah-pause[data-paused] .ah-pause-i,
  .ah[data-static] .ah-pause {
    display: none;
  }
  .ah-pause[data-paused] .ah-play-i {
    display: block;
  }

  @media (max-width: 40rem) {
    .ah-photo {
      border-radius: 1rem;
    }
    /* no telemóvel, o resumo do dia tapava a consola: fica só a fotografia */
    .ah-panel {
      display: none;
    }
    .ah-caption {
      margin-top: 1.25rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-ah]");
    if (!root) return;
    var q = function (s) {
      return root.querySelector(s);
    };
    var qa = function (s) {
      return Array.prototype.slice.call(root.querySelectorAll(s));
    };
    var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
    var canAnimate = typeof Element.prototype.animate === "function";

    /* ---------- cola cada superfície nos 4 cantos medidos na foto ---------- */
    function adj(m) {
      return [
        m[4] * m[8] - m[5] * m[7], m[2] * m[7] - m[1] * m[8], m[1] * m[5] - m[2] * m[4],
        m[5] * m[6] - m[3] * m[8], m[0] * m[8] - m[2] * m[6], m[2] * m[3] - m[0] * m[5],
        m[3] * m[7] - m[4] * m[6], m[1] * m[6] - m[0] * m[7], m[0] * m[4] - m[1] * m[3],
      ];
    }
    function mm(a, b) {
      var c = [];
      for (var i = 0; i < 3; i++)
        for (var j = 0; j < 3; j++) {
          var s = 0;
          for (var k = 0; k < 3; k++) s += a[3 * i + k] * b[3 * k + j];
          c[3 * i + j] = s;
        }
      return c;
    }
    function mv(m, v) {
      return [m[0] * v[0] + m[1] * v[1] + m[2] * v[2], m[3] * v[0] + m[4] * v[1] + m[5] * v[2], m[6] * v[0] + m[7] * v[1] + m[8] * v[2]];
    }
    function basis(p) {
      var m = [p[0], p[2], p[4], p[1], p[3], p[5], 1, 1, 1];
      var v = mv(adj(m), [p[6], p[7], 1]);
      return mm(m, [v[0], 0, 0, 0, v[1], 0, 0, 0, v[2]]);
    }
    function project(src, dst) {
      var t = mm(basis(dst), adj(basis(src)));
      for (var i = 0; i < 9; i++) t[i] = t[i] / t[8];
      return "matrix3d(" + [t[0], t[3], 0, t[6], t[1], t[4], 0, t[7], 0, 0, 1, 0, t[2], t[5], 0, t[8]].join(",") + ")";
    }
    var photo = q("[data-photo]");
    var surfaces = qa("[data-quad]");
    function mapSurfaces() {
      var k = photo.clientWidth / 920;
      if (!k) return;
      surfaces.forEach(function (el) {
        var w = el.offsetWidth;
        var h = el.offsetHeight;
        var p = el.getAttribute("data-quad").split(" ").map(function (xy) {
          return xy.split(",").map(function (n) {
            return parseFloat(n) * k;
          });
        });
        el.style.transform = project([0, 0, w, 0, 0, h, w, h], [p[0][0], p[0][1], p[1][0], p[1][1], p[2][0], p[2][1], p[3][0], p[3][1]]);
      });
      photo.classList.add("is-mapped");
    }
    mapSurfaces();
    if ("ResizeObserver" in window) new ResizeObserver(mapSurfaces).observe(photo);
    else addEventListener("resize", mapSurfaces);

    if (reduce || !canAnimate) return;
    root.removeAttribute("data-static");

    /* ---------- coreografia: a conversa acontece nos dois ecrãs ao mesmo tempo ---------- */
    var E = "cubic-bezier(.16,1,.3,1)";
    var lmsg = qa("[data-lmsg]");
    var pmsg = qa("[data-pmsg]");
    var ltyping = q("[data-ltyping]");
    var ptyping = q("[data-ptyping]");
    var handoff = q("[data-handoff]");
    var stats = qa("[data-stat]");
    var base = stats.map(function (s) {
      return parseInt(s.textContent, 10);
    });
    // Agendador que se pode pausar: cada passo guarda quando devia correr; ao retomar, só os
    // passos que faltam voltam a ser agendados, com o tempo que lhes restava.
    var timers = [];
    function at(ms, fn) {
      var t = { fn: fn, due: Date.now() + ms, left: ms };
      t.id = setTimeout(function () {
        var i = timers.indexOf(t);
        if (i >= 0) timers.splice(i, 1);
        fn();
      }, ms);
      timers.push(t);
    }
    function show(el, dy) {
      el.classList.add("is-on");
      el.animate([{ opacity: 0, transform: "translateY(" + (dy || 8) + "px) scale(.97)" }, { opacity: 1, transform: "none" }], {
        duration: 480,
        easing: E,
        fill: "forwards",
      });
    }
    function hide(el, ms) {
      el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: ms || 200, fill: "forwards" });
    }
    function typing(on) {
      [ltyping, ptyping].forEach(function (el) {
        if (on) {
          // o indicador vai sempre para o fim da conversa
          el.parentNode.appendChild(el);
          show(el, 4);
          el.querySelectorAll("i").forEach(function (d, i) {
            d.animate([{ opacity: 0.35 }, { opacity: 1 }, { opacity: 0.35 }], { duration: 700, delay: i * 120, iterations: 2 });
          });
        } else {
          hide(el, 120);
          el.classList.remove("is-on");
        }
      });
    }
    function setStats(d) {
      stats.forEach(function (s, i) {
        s.textContent = String(base[i] - d[i]);
      });
    }
    function bump(i) {
      var cur = parseInt(stats[i].textContent, 10);
      stats[i].textContent = String(cur + 1);
      stats[i].animate([{ transform: "translateY(-4px)", opacity: 0.2 }, { transform: "none", opacity: 1 }], { duration: 380, easing: E });
    }
    function reset() {
      timers.forEach(function (t) {
        clearTimeout(t.id);
      });
      timers = [];
      lmsg.concat(pmsg, [ltyping, ptyping, handoff]).forEach(function (n) {
        n.getAnimations().forEach(function (x) {
          x.cancel();
        });
        n.classList.remove("is-on");
      });
      setStats([1, 2, 1]);
    }
    function msg(i) {
      show(lmsg[i]);
      show(pmsg[i]);
    }
    function run() {
      reset();
      at(500, function () {
        msg(0);
        bump(0);
      });
      at(1300, function () {
        typing(true);
      });
      at(2600, function () {
        typing(false);
        msg(1);
        bump(1);
      });
      at(4000, function () {
        msg(2);
      });
      at(4800, function () {
        typing(true);
      });
      at(6100, function () {
        typing(false);
        msg(3);
        bump(1);
      });
      at(6800, function () {
        show(handoff, 14);
        bump(2);
      });
      at(11200, function () {
        lmsg.concat(pmsg, [handoff]).forEach(function (n) {
          hide(n, 450);
        });
      });
      at(12000, run);
    }
    run();

    /* ---------- pausar / retomar (continua onde parou) ---------- */
    var pauseBtn = q("[data-pause]");
    var paused = false;
    pauseBtn.addEventListener("click", function () {
      paused = !paused;
      pauseBtn.toggleAttribute("data-paused", paused);
      pauseBtn.setAttribute("aria-label", pauseBtn.getAttribute(paused ? "data-label-play" : "data-label-pause"));
      var anims = root.getAnimations({ subtree: true });
      if (paused) {
        var now = Date.now();
        timers.forEach(function (t) {
          clearTimeout(t.id);
          t.left = Math.max(0, t.due - now);
        });
        anims.forEach(function (x) {
          x.pause();
        });
      } else {
        var pending = timers;
        timers = [];
        pending.forEach(function (t) {
          at(t.left, t.fn);
        });
        anims.forEach(function (x) {
          if (x.playState === "paused") x.play();
        });
      }
    });
  })();
</script>
