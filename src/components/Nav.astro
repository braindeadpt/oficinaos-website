---
// Cabeçalho do site (redesign, fase 1).
// - Desktop: Produtos (popover nativo) · Guia · Novidades | idioma (popover) · GitHub · tema · Descarregar
// - Móvel: Descarregar + menu num <dialog> modal (foco preso, Esc, fundo inerte — tudo nativo)
// Sem JS para abrir popovers (atributo popovertarget); o JS só gere o <dialog> e o tema.
import type { Copy } from "../i18n/pt";
import GithubMark from "./GithubMark.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import {
  currentPagePath,
  LOCALE_LABELS,
  LOCALES,
  localeUrl,
  REPO_URL,
} from "../i18n/utils";
import type { Locale } from "../i18n/utils";
import { products } from "../lib/products";
import { getRepoStars, STARS_MIN_TO_SHOW } from "../lib/github";
import { downloadAttrs } from "../lib/download";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
const theme = t.nav.theme;
// O seletor de idioma mantém o utilizador na mesma página, não na raiz do idioma.
const pagePath = currentPagePath(Astro.url.pathname, locale);
const items = products(t, locale);

const isDocs = pagePath.startsWith("/docs");
const isUpdates = pagePath.startsWith("/updates");
const activeProduct =
  pagePath === "/"
    ? "os"
    : pagePath.startsWith("/diag")
      ? "diag"
      : pagePath.startsWith("/pro")
        ? "pro"
        : pagePath.startsWith("/trade")
          ? "trade"
          : null;

const links = [
  { href: localeUrl(locale, "/docs/"), label: t.nav.docs, current: isDocs && !activeProduct },
  { href: localeUrl(locale, "/updates/"), label: t.nav.updates, current: isUpdates },
];

const dl = downloadAttrs(locale);
const stars = await getRepoStars();
const showStars = stars !== null && stars >= STARS_MIN_TO_SHOW;
const starsText = showStars
  ? new Intl.NumberFormat(locale, { notation: "compact", maximumFractionDigits: 1 }).format(stars!)
  : null;
const githubAria = showStars
  ? `${t.nav.githubLabel} · ${starsText} ${t.nav.githubStars}`
  : `${t.nav.githubLabel} · ${t.nav.openSource}`;

const chevron =
  '<path d="m6 9 6 6 6-6"/>';
---

<a
  href="#main"
  class="skip-link fixed top-2 left-2 z-[60] -translate-y-16 rounded-md bg-primary px-4 py-2.5 text-base font-semibold text-on-primary shadow-md focus-visible:translate-y-0"
>
  {t.nav.skipToContent}
</a>

<header class="site-header sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:px-6 lg:gap-6"
    aria-label={t.nav.menuLabel}
  >
    <a
      href={localeUrl(locale)}
      class="vt-brand -ml-1 flex shrink-0 items-center rounded-md p-1"
      aria-label="OficinaOS"
      aria-current={pagePath === "/" ? "page" : undefined}
    >
      <Logo class="h-7 w-auto sm:h-8" />
    </a>

    <!-- Desktop: navegação principal -->
    <ul class="hidden items-center gap-1 lg:flex" role="list">
      <li>
        <button
          type="button"
          popovertarget="nav-products"
          class="nav-products-anchor nav-link group inline-flex h-10 items-center gap-1 rounded-md px-3 text-base font-medium"
          data-active={activeProduct ? "true" : undefined}
        >
          {t.nav.products}
          <svg class="nav-chevron h-4 w-4 text-text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={chevron} />
        </button>
      </li>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link inline-flex h-10 items-center rounded-md px-3 text-base font-medium"
              aria-current={l.current ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <!-- Desktop: idioma compacto -->
      <button
        type="button"
        popovertarget="nav-lang"
        class="nav-lang-anchor nav-link hidden h-10 items-center gap-1.5 rounded-md px-2.5 text-sm font-semibold lg:inline-flex"
        aria-label={`${t.nav.languageMenuLabel} (${t.nav.languageNames[locale]})`}
      >
        <Icon name="globe" class="h-4 w-4 text-text-subtle" />
        <span>{LOCALE_LABELS[locale]}</span>
        <svg class="nav-chevron h-3.5 w-3.5 text-text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={chevron} />
      </button>

      <!-- Desktop: GitHub (estilo «stars») -->
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={githubAria}
        class="hidden h-9 items-stretch overflow-hidden rounded-md border border-border bg-surface text-sm font-medium text-text-muted transition-colors hover:border-border-strong hover:text-text lg:inline-flex"
      >
        <span class="flex items-center gap-1.5 px-2.5">
          <GithubMark class="h-4 w-4" />
          GitHub
        </span>
        <span class="num flex items-center gap-1 border-l border-border bg-surface-2 px-2.5 text-xs font-semibold" aria-hidden="true">
          {
            showStars ? (
              <>
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9z" /></svg>
                {starsText}
              </>
            ) : (
              "MIT"
            )
          }
        </span>
      </a>

      <!-- Tema (desktop) -->
      <button
        type="button"
        class="js-theme-toggle nav-icon-btn hidden h-10 w-10 shrink-0 items-center justify-center rounded-md lg:inline-flex"
        data-label={theme.label}
        data-system={theme.system}
        data-light={theme.light}
        data-dark={theme.dark}
        aria-label={`${theme.label}: ${theme.system}`}
        title={`${theme.label}: ${theme.system}`}
      >
        <svg class="theme-icon theme-icon-system h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
        <svg class="theme-icon theme-icon-light hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        <svg class="theme-icon theme-icon-dark hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
      </button>

      <a
        {...dl}
        class="inline-flex h-10 items-center gap-1.5 rounded-md bg-primary px-3.5 text-base font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-hover"
      >
        <Icon name="download" class="h-4 w-4" />
        {t.nav.download}
      </a>

      <!-- Móvel: abre o menu -->
      <button
        type="button"
        class="js-sheet-open nav-icon-btn inline-flex h-10 w-10 items-center justify-center rounded-md border border-border-strong bg-surface lg:hidden"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="nav-sheet"
        aria-label={t.nav.openMenu}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Popover: produtos -->
  <div id="nav-products" popover class="oos-popover nav-pop nav-pop-products">
    <nav aria-label={t.nav.productsMenuLabel}>
    <ul class="grid grid-cols-2 gap-1 p-2" role="list">
      {
        items.map((p) => (
          <li data-product={p.id}>
            <a
              href={p.href}
              class="nav-product group flex h-full gap-3 rounded-lg p-3"
              aria-current={activeProduct === p.id ? "page" : undefined}
              {...(p.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-[3px] bg-product" aria-hidden="true" />
              <span class="min-w-0">
                <span class="flex items-center gap-1 text-base font-semibold text-text">
                  {p.name}
                  {p.external && <Icon name="external" class="h-3.5 w-3.5 text-text-subtle" />}
                  {p.external && <span class="sr-only">({t.footer.externalHint})</span>}
                </span>
                <span class="mt-0.5 block text-sm text-text-muted">{p.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    </nav>
  </div>

  <!-- Popover: idioma -->
  <div id="nav-lang" popover class="oos-popover nav-pop nav-pop-lang">
    <ul class="p-1.5" role="list" aria-label={t.nav.languageMenuLabel}>
      {
        LOCALES.map((l) => (
          <li>
            <a
              href={localeUrl(l, pagePath)}
              hreflang={l}
              lang={l === "pt" ? "pt-PT" : l}
              aria-current={l === locale ? "true" : undefined}
              class="nav-lang-item flex items-center justify-between gap-6 rounded-md px-3 py-2 text-base"
            >
              {t.nav.languageNames[l]}
              <span class="text-xs font-semibold text-text-subtle">{LOCALE_LABELS[l]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Móvel: menu -->
  <dialog id="nav-sheet" class="oos-sheet nav-sheet" aria-label={t.nav.menuLabel}>
    <div class="flex h-full flex-col">
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-border px-4">
        <Logo class="h-7 w-auto" />
        <button
          type="button"
          class="js-sheet-close nav-icon-btn inline-flex h-10 w-10 items-center justify-center rounded-md"
          aria-label={t.nav.closeMenu}
          autofocus
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto px-3 py-4">
        <p class="px-3 pb-2 text-sm font-semibold text-text-subtle" id="nav-sheet-products">{t.nav.products}</p>
        <ul role="list" aria-labelledby="nav-sheet-products">
          {
            items.map((p) => (
              <li data-product={p.id}>
                <a
                  href={p.href}
                  class="nav-product flex gap-3 rounded-lg px-3 py-3"
                  aria-current={activeProduct === p.id ? "page" : undefined}
                  {...(p.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-[3px] bg-product" aria-hidden="true" />
                  <span class="min-w-0">
                    <span class="flex items-center gap-1 text-md font-semibold text-text">
                      {p.name}
                      {p.external && <Icon name="external" class="h-3.5 w-3.5 text-text-subtle" />}
                      {p.external && <span class="sr-only">({t.footer.externalHint})</span>}
                    </span>
                    <span class="mt-0.5 block text-sm text-text-muted">{p.desc}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <ul role="list" class="mt-3 border-t border-border pt-3">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="nav-product block rounded-lg px-3 py-3 text-md font-semibold text-text"
                  aria-current={l.current ? "page" : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-product flex items-center gap-2 rounded-lg px-3 py-3 text-md font-semibold text-text"
            >
              <GithubMark class="h-4 w-4" />
              GitHub
              <span class="text-sm font-normal text-text-muted">· {showStars ? `${starsText} ${t.nav.githubStars}` : t.nav.openSource}</span>
              <span class="sr-only">({t.footer.externalHint})</span>
            </a>
          </li>
        </ul>

        <div class="mt-3 space-y-3 border-t border-border px-3 pt-4">
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-text-muted" id="nav-sheet-lang">{t.nav.language}</span>
            <ul role="list" aria-labelledby="nav-sheet-lang" class="flex rounded-md border border-border bg-surface-2 p-0.5">
              {
                LOCALES.map((l) => (
                  <li>
                    <a
                      href={localeUrl(l, pagePath)}
                      hreflang={l}
                      lang={l === "pt" ? "pt-PT" : l}
                      aria-current={l === locale ? "true" : undefined}
                      aria-label={t.nav.languageNames[l]}
                      class="seg-item inline-flex h-10 min-w-12 items-center justify-center rounded-[6px] px-3 text-sm font-semibold"
                    >
                      {LOCALE_LABELS[l]}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <button
            type="button"
            class="js-theme-toggle flex h-11 w-full items-center gap-2 rounded-md text-sm text-text-muted transition-colors hover:text-text"
            data-label={theme.label}
            data-system={theme.system}
            data-light={theme.light}
            data-dark={theme.dark}
          >
            <svg class="theme-icon theme-icon-system h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
            <svg class="theme-icon theme-icon-light hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
            <svg class="theme-icon theme-icon-dark hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            <span class="theme-text">{theme.label}: {theme.system}</span>
          </button>
        </div>
      </div>

      <div class="shrink-0 border-t border-border p-4">
        <a
          {...dl}
          class="flex h-12 w-full items-center justify-center gap-2 rounded-md bg-primary text-md font-semibold text-on-primary shadow-sm transition-colors hover:bg-primary-hover"
        >
          <Icon name="download" class="h-4 w-4" />
          {t.hero.ctaPrimary}
        </a>
      </div>
    </div>
  </dialog>
</header>

<script>
  // Tema: automático (sistema) → claro → escuro. Guardado em localStorage "oos-theme".
  const themeBtns = document.querySelectorAll<HTMLButtonElement>(".js-theme-toggle");
  if (themeBtns.length) {
    const order = ["system", "light", "dark"] as const;
    type Mode = (typeof order)[number];
    const read = (): Mode => {
      try {
        const v = localStorage.getItem("oos-theme");
        return v === "light" || v === "dark" ? v : "system";
      } catch {
        return "system";
      }
    };
    const apply = (mode: Mode) => {
      const root = document.documentElement;
      if (mode === "system") delete root.dataset.theme;
      else root.dataset.theme = mode;
      themeBtns.forEach((b) => {
        const label = `${b.dataset.label}: ${b.dataset[mode]}`;
        const text = b.querySelector(".theme-text");
        if (text) text.textContent = label;
        else {
          b.setAttribute("aria-label", label);
          b.setAttribute("title", label);
        }
        b.querySelectorAll<SVGElement>(".theme-icon").forEach((el) => {
          el.classList.toggle("hidden", !el.classList.contains(`theme-icon-${mode}`));
        });
      });
    };
    apply(read());
    themeBtns.forEach((b) =>
      b.addEventListener("click", () => {
        const next = order[(order.indexOf(read()) + 1) % order.length];
        try {
          if (next === "system") localStorage.removeItem("oos-theme");
          else localStorage.setItem("oos-theme", next);
        } catch {}
        apply(next);
      })
    );
  }

  // Menu móvel em <dialog> modal: foco preso, Esc e fundo inerte vêm do browser.
  const sheet = document.getElementById("nav-sheet") as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>(".js-sheet-open");
  if (sheet && opener && typeof sheet.showModal === "function") {
    opener.addEventListener("click", () => {
      sheet.showModal();
      opener.setAttribute("aria-expanded", "true");
    });
    sheet.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"));
    sheet.querySelector(".js-sheet-close")?.addEventListener("click", () => sheet.close());
    sheet.addEventListener("click", (e) => {
      const target = e.target as Element;
      // Clique no fundo (fora do painel) ou num link → fecha.
      if (target === sheet || target.closest("a")) sheet.close();
    });
    // Se a janela crescer para desktop com o menu aberto, fecha-o.
    matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
      if (e.matches && sheet.open) sheet.close();
    });
  }
</script>
