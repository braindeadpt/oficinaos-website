---
import type { Copy } from "../i18n/pt";
import GithubMark from "./GithubMark.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import {
  currentPagePath,
  INSTALL_ZIP_URL,
  LOCALE_LABELS,
  LOCALES,
  localeUrl,
  REPO_URL,
} from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  t: Copy;
  locale: Locale;
}
const { t, locale } = Astro.props;
// Seletor de tema (Automático · Claro · Escuro), §5 do design system.
const THEME_LABELS: Record<Locale, { label: string; system: string; light: string; dark: string }> = {
  pt: { label: "Tema", system: "automático", light: "claro", dark: "escuro" },
  en: { label: "Theme", system: "automatic", light: "light", dark: "dark" },
  es: { label: "Tema", system: "automático", light: "claro", dark: "oscuro" },
};
const themeLabels = THEME_LABELS[locale];
// Language switcher must keep the user on the same page, not the
// locale root.
const pagePath = currentPagePath(Astro.url.pathname, locale);
const links = [
  { href: `${localeUrl(locale)}#features`, label: t.nav.features },
  { href: `${localeUrl(locale)}#diag`, label: t.nav.diag },
  { href: `${localeUrl(locale)}#pro`, label: t.nav.pro },
  { href: `${localeUrl(locale)}#install`, label: t.nav.install },
  { href: localeUrl(locale, "/docs"), label: t.nav.docs },
  { href: localeUrl(locale, "/updates"), label: t.nav.updates },
];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
    aria-label={t.nav.menuLabel}
  >
    <a
      href={localeUrl(locale)}
      class="flex shrink-0 items-center rounded-md"
      aria-label="OficinaOS"
    >
      <Logo class="h-7 w-auto sm:h-9" />
    </a>
    <div class="flex items-center gap-2 text-base text-text-muted sm:gap-3 lg:gap-5">
      {
        links.map((l) => (
          <a href={l.href} class="hidden font-medium transition hover:text-text lg:inline">
            {l.label}
          </a>
        ))
      }
      <div
        class="hidden items-center gap-1 rounded-full border border-border bg-surface p-0.5 sm:flex"
      >
        {
          LOCALES.map((l) => (
            <a
              href={localeUrl(l, pagePath)}
              hreflang={l}
              aria-current={l === locale ? "true" : undefined}
              class:list={[
                "rounded-full px-2.5 py-1 text-xs font-semibold transition",
                l === locale
                  ? "bg-primary text-on-primary"
                  : "text-text-muted hover:bg-surface-2 hover:text-text",
              ]}
            >
              {LOCALE_LABELS[l]}
            </a>
          ))
        }
      </div>
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.githubLabel}
        title={t.nav.githubLabel}
        class="hidden h-10 w-10 items-center justify-center rounded-md text-text-muted transition hover:bg-surface-2 hover:text-text lg:flex"
      >
        <GithubMark class="h-5 w-5" />
      </a>
      <button
        type="button"
        class="js-theme-toggle hidden h-10 w-10 shrink-0 items-center justify-center rounded-md text-text-muted transition hover:bg-surface-2 hover:text-text sm:inline-flex"
        data-label={themeLabels.label}
        data-system={themeLabels.system}
        data-light={themeLabels.light}
        data-dark={themeLabels.dark}
        aria-label={`${themeLabels.label}: ${themeLabels.system}`}
        title={`${themeLabels.label}: ${themeLabels.system}`}
      >
        <svg class="theme-icon theme-icon-system h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
        <svg class="theme-icon theme-icon-light hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        <svg class="theme-icon theme-icon-dark hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
      </button>
      <a
        href={INSTALL_ZIP_URL}
        class="inline-flex h-10 items-center gap-1.5 rounded-md bg-primary px-3 text-base font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover lg:hidden"
      >
        <Icon name="download" class="h-4 w-4" />
        {t.nav.download}
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border-strong bg-surface text-text transition hover:bg-surface-2 lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={t.nav.openMenu}
        data-open-label={t.nav.openMenu}
        data-close-label={t.nav.closeMenu}
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="nav-icon-close hidden" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </nav>
  <div
    id="nav-panel"
    class="hidden border-t border-border bg-surface lg:hidden"
  >
    <ul class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block rounded-md px-3 py-3 text-base font-medium text-text transition hover:bg-surface-2 hover:text-text"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-border pt-3">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md px-3 py-3 text-sm text-text-muted transition hover:bg-surface-2 hover:text-text"
        >
          <GithubMark class="h-4 w-4" />
          {t.nav.githubLabel}
        </a>
      </li>
      <li class="px-3 py-1 sm:hidden">
        <button
          type="button"
          class="js-theme-toggle flex w-full items-center gap-2 rounded-md py-2 text-sm text-text-muted transition hover:text-text"
          data-label={themeLabels.label}
          data-system={themeLabels.system}
          data-light={themeLabels.light}
          data-dark={themeLabels.dark}
        >
          <svg class="theme-icon theme-icon-system h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
          <svg class="theme-icon theme-icon-light hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
          <svg class="theme-icon theme-icon-dark hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          <span class="theme-text">{themeLabels.label}: {themeLabels.system}</span>
        </button>
      </li>
      <li class="flex items-center gap-2 px-3 py-3 sm:hidden">
        <span class="text-sm text-text-muted">{t.nav.language}:</span>
        {
          LOCALES.map((l) => (
            <a
              href={localeUrl(l, pagePath)}
              hreflang={l}
              aria-current={l === locale ? "true" : undefined}
              class:list={[
                "rounded-full px-3 py-1.5 text-sm font-medium transition",
                l === locale
                  ? "bg-primary text-on-primary"
                  : "border border-border-strong bg-surface text-text hover:bg-surface-2",
              ]}
            >
              {LOCALE_LABELS[l]}
            </a>
          ))
        }
      </li>
    </ul>
  </div>
</header>

<script>
  // Tema: automático (sistema) → claro → escuro. Guardado em localStorage "oos-theme".
  const themeBtns = document.querySelectorAll<HTMLButtonElement>(".js-theme-toggle");
  if (themeBtns.length) {
    const order = ["system", "light", "dark"] as const;
    type Mode = (typeof order)[number];
    const read = (): Mode => {
      try {
        const v = localStorage.getItem("oos-theme");
        return v === "light" || v === "dark" ? v : "system";
      } catch {
        return "system";
      }
    };
    const apply = (mode: Mode) => {
      const root = document.documentElement;
      if (mode === "system") delete root.dataset.theme;
      else root.dataset.theme = mode;
      themeBtns.forEach((b) => {
        const label = `${b.dataset.label}: ${b.dataset[mode]}`;
        const text = b.querySelector(".theme-text");
        if (text) text.textContent = label;
        else {
          b.setAttribute("aria-label", label);
          b.setAttribute("title", label);
        }
        b.querySelectorAll<SVGElement>(".theme-icon").forEach((el) => {
          el.classList.toggle("hidden", !el.classList.contains(`theme-icon-${mode}`));
        });
      });
    };
    apply(read());
    themeBtns.forEach((b) =>
      b.addEventListener("click", (e) => {
        e.stopPropagation();
        const next = order[(order.indexOf(read()) + 1) % order.length];
        try {
          if (next === "system") localStorage.removeItem("oos-theme");
          else localStorage.setItem("oos-theme", next);
        } catch {}
        apply(next);
      })
    );
  }

  const btn = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-panel");
  if (btn && panel) {
    const set = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute(
        "aria-label",
        (open ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? ""
      );
      panel.classList.toggle("hidden", !open);
      btn.querySelector(".nav-icon-open")?.classList.toggle("hidden", open);
      btn.querySelector(".nav-icon-close")?.classList.toggle("hidden", !open);
    };
    btn.addEventListener("click", () =>
      set(btn.getAttribute("aria-expanded") !== "true")
    );
    // Close after following an in-page link, and on Escape.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        set(false);
        btn.focus();
      }
    });
  }
</script>
