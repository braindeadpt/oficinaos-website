---
import type { Copy } from "../i18n/pt";
import { DIAG_REPO_URL, DIAG_STORE_URL, DIAG_ZIP_URL } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<section id="diag" class="border-y border-border bg-surface">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <span
        class="inline-block rounded-full border border-primary-soft bg-primary-soft px-3 py-1 text-xs font-medium text-on-primary-soft"
      >
        {t.diag.badge}
      </span>
      <h2
        class="mt-4 text-2xl font-extrabold tracking-tight text-text sm:text-3xl"
      >
        {t.diag.title}
      </h2>
      <p class="mt-4 text-lg text-text-muted">{t.diag.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-border bg-surface shadow-sm p-8">
        <h3 class="flex items-center gap-2 text-lg font-bold text-text">
          <Icon name="smartphone" class="h-5 w-5 text-primary" />
          {t.diag.customerTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-base text-text-muted">
          {
            t.diag.customerItems.map((item) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-lg border border-border bg-surface shadow-sm p-8">
        <h3 class="flex items-center gap-2 text-lg font-bold text-text">
          <Icon name="wrench" class="h-5 w-5 text-primary" />
          {t.diag.shopTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-base text-text-muted">
          {
            t.diag.shopItems.map((item) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href={DIAG_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-[18px] text-md font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover"
      >
        <Icon name="external" class="h-4 w-4" />
        Microsoft Store
      </a>
      <a
        href={DIAG_ZIP_URL}
        class="inline-flex h-12 items-center justify-center gap-2 rounded-md border border-border-strong bg-surface px-[18px] text-md font-semibold text-text transition hover:bg-surface-2"
      >
        <Icon name="arrow" class="h-4 w-4 -rotate-90" />
        {t.diag.cta}
      </a>
      <a
        href={DIAG_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-link transition hover:text-primary-hover"
      >
        {t.diag.repoLink}
        <Icon name="external" class="h-3.5 w-3.5" />
      </a>
      <p class="w-full text-xs text-text-muted sm:w-auto sm:flex-1">
        {t.diag.note}
      </p>
    </div>
  </div>
</section>
