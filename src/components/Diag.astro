---
import type { Copy } from "../i18n/pt";
import { DIAG_REPO_URL, DIAG_ZIP_URL } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<section id="diag" class="border-y border-zinc-800/60 bg-zinc-950/60">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <span
        class="inline-block rounded-full border border-teal-500/30 bg-teal-500/10 px-3 py-1 text-xs font-medium text-teal-300"
      >
        {t.diag.badge}
      </span>
      <h2
        class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
      >
        {t.diag.title}
      </h2>
      <p class="mt-4 text-lg text-zinc-400">{t.diag.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
        <h3 class="flex items-center gap-2 font-semibold text-white">
          <Icon name="smartphone" class="h-5 w-5 text-teal-400" />
          {t.diag.customerTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-zinc-400">
          {
            t.diag.customerItems.map((item) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
        <h3 class="flex items-center gap-2 font-semibold text-white">
          <Icon name="wrench" class="h-5 w-5 text-teal-400" />
          {t.diag.shopTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-zinc-400">
          {
            t.diag.shopItems.map((item) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href={DIAG_ZIP_URL}
        class="inline-flex items-center gap-2 rounded-lg bg-teal-500 px-5 py-3 font-semibold text-zinc-950 transition hover:bg-teal-400"
      >
        <Icon name="arrow" class="h-4 w-4 -rotate-90" />
        {t.diag.cta}
      </a>
      <a
        href={DIAG_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-400 transition hover:text-teal-300"
      >
        {t.diag.repoLink}
        <Icon name="external" class="h-3.5 w-3.5" />
      </a>
      <p class="w-full text-xs text-zinc-500 sm:w-auto sm:flex-1">
        {t.diag.note}
      </p>
    </div>
  </div>
</section>
