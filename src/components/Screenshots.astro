---
import type { Copy } from "../i18n/pt";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---

<section class="mx-auto max-w-4xl px-6 pb-24">
  <div class="max-w-2xl">
    <h2 class="text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
      {t.screenshots.title}
    </h2>
    <p class="mt-4 text-lg text-text-muted">{t.screenshots.subtitle}</p>
  </div>
  <div
    class="mt-12 overflow-hidden rounded-xl border border-border bg-surface-2 shadow-lg"
  >
    <video
      src={`${import.meta.env.BASE_URL}video/oficinaos-demo.mp4`}
      poster={`${import.meta.env.BASE_URL}screenshots/dashboard.webp`}
      class="aspect-[20/9] w-full"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      controls
      aria-label={t.screenshots.videoAria}></video>
  </div>
</section>
