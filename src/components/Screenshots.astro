---
import type { Copy } from "../i18n/pt";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

// Order must match t.screenshots.items captions.
const SCREENSHOT_FILES = ["dashboard.png", "job-detail.png", "tracking.png"];
---

<section class="mx-auto max-w-6xl px-6 pb-24">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      {t.screenshots.title}
    </h2>
    <p class="mt-4 text-lg text-zinc-400">{t.screenshots.subtitle}</p>
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      t.screenshots.items.map((name, i) => (
        <figure class="overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/50">
          <div class="flex items-center gap-1.5 border-b border-zinc-800 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700" />
          </div>
          <img
            src={`${import.meta.env.BASE_URL}screenshots/${SCREENSHOT_FILES[i]}`}
            alt={name}
            loading="lazy"
            class="aspect-video w-full object-cover object-top"
          />
          <figcaption class="border-t border-zinc-800 px-4 py-3 text-sm text-zinc-400">
            {name}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
