---
// Secção #pro da home (fase 3): curta, com o essencial e o caminho para /pro.
// A âncora #pro mantém-se: links antigos e o redirect da Cloud depois do formulário do beta
// (cloud.oficinaos.app/beta-signup → /<idioma>/?beta=ok#pro) continuam a funcionar — o script
// abaixo reencaminha ?beta=… para /pro/#beta, onde está o formulário e o aviso.
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { DEFAULT_LOCALE, localeUrl } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const proUrl = localeUrl(locale, "/pro/");
---

<section id="pro" data-product="pro" aria-labelledby="pro-title" class="scroll-mt-16 border-y border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
    <div class="max-w-2xl">
      <p class="flex flex-wrap items-center gap-3 text-sm font-semibold text-product">
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-[3px] bg-product" aria-hidden="true"></span>
          Pro
        </span>
        <span class="rounded-full bg-product-soft px-2.5 py-0.5 text-xs font-semibold text-on-product-soft">{t.pro.badge}</span>
      </p>
      <h2 id="pro-title" class="mt-3 text-[clamp(1.875rem,3.6vw,2.5rem)] leading-[1.1] font-extrabold tracking-[-0.025em] text-balance text-text">
        {t.pro.title}
      </h2>
      <p class="mt-4 text-pretty text-lg text-text-muted">{t.pro.teaser}</p>
      <p class="mt-4 border-l-2 border-product pl-4 text-text">{t.pro.cloudEngine}</p>
    </div>
    <div class="reveal">
      <ul role="list" class="flex flex-wrap gap-2 text-sm font-medium text-text">
        {t.pro.groups.map((g) => <li class="rounded-md border border-border bg-bg px-3 py-1.5">{g}</li>)}
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <a
          href={proUrl}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-product px-5 text-md font-semibold text-on-product shadow-sm transition-colors hover:bg-product-hover"
        >
          {t.pro.more}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a
          href={`${proUrl}#beta`}
          class="inline-flex h-12 items-center justify-center rounded-md px-2 text-md font-semibold text-link underline decoration-border-strong underline-offset-4 transition-colors hover:text-primary-hover sm:justify-start"
        >
          {t.pro.ctaBeta}
        </a>
      </div>
    </div>
  </div>
  <span hidden data-pro-url={proUrl}></span>
</section>

<script>
  // Resposta do formulário do beta: a Cloud volta para /<idioma>/?beta=…#pro → seguir para /pro/#beta.
  const status = new URLSearchParams(location.search).get("beta");
  const target = document.querySelector<HTMLElement>("[data-pro-url]")?.dataset.proUrl;
  if (status && target && /^(ok|invalid|rate)$/.test(status)) {
    location.replace(`${target}?beta=${status}#beta`);
  }
</script>
