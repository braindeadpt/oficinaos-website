---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { CLOUD_URL, CONTACT_EMAIL, DEFAULT_LOCALE, localeUrl } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;

// Beta sign-up form. Set PUBLIC_BETA_FORM_ENDPOINT at build time (e.g. a
// Formspree URL "https://formspree.io/f/xxxx", or any endpoint that accepts
// a urlencoded POST) — in CI it comes from the repository variable of the
// same name (see .github/workflows/deploy.yml). While unset, the form falls
// back to opening an email to CONTACT_EMAIL with the fields filled in.
const FORM_ENDPOINT = (import.meta.env.PUBLIC_BETA_FORM_ENDPOINT ?? "").trim();
const MAILTO = `mailto:${CONTACT_EMAIL}`;

const icons = [
  "globe",
  "message",
  "message",
  "activity",
  "badge",
  "clipboard",
  "cart",
  "box",
  "activity",
  "archive",
  "bell",
] as const;
const inputClass =
  "w-full rounded-xl border border-zinc-700 bg-zinc-950 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none transition focus:border-teal-500";
---

<section id="pro" class="border-y border-zinc-800/60 bg-zinc-900/30">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-medium text-amber-300"
      >
        {t.pro.badge}
      </span>
      <h2
        class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
      >
        {t.pro.title}
      </h2>
      <p class="mt-4 text-lg text-zinc-400">{t.pro.subtitle}</p>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.pro.modules.map((m, i) => (
          <a
            href={localeUrl(locale, m.href)}
            class="group rounded-2xl border border-zinc-800 bg-zinc-900/30 p-5 transition hover:border-zinc-600"
          >
            <div class="flex items-center justify-between">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
                <Icon name={icons[i % icons.length]} class="h-4 w-4" />
              </div>
              <span class="rounded-full border border-teal-500/30 bg-teal-500/10 px-2 py-0.5 text-[11px] font-medium text-teal-300">
                {t.pro.statusLabel}
              </span>
            </div>
            <h3 class="mt-3 font-semibold text-white group-hover:text-teal-300">
              {m.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{m.desc}</p>
          </a>
        ))
      }
    </div>
    <div
      class="mt-12 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-8"
    >
      <div class="text-center">
        <h3 class="text-xl font-semibold text-white">{t.pro.signup.title}</h3>
        <p class="mx-auto mt-2 max-w-xl text-sm text-zinc-400">
          {t.pro.signup.subtitle}
        </p>
      </div>
      <form
        id="beta-signup"
        action={FORM_ENDPOINT || MAILTO}
        method="POST"
        enctype={FORM_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}
        data-mailto={FORM_ENDPOINT ? undefined : CONTACT_EMAIL}
        data-subject={t.pro.signup.mailSubject}
        data-label-email={t.pro.signup.email}
        data-label-shop={t.pro.signup.shop}
        data-label-city={t.pro.signup.city}
        data-label-phone={t.pro.signup.phone}
        data-label-language={t.pro.signup.languageLabel}
        class="mx-auto mt-6 grid max-w-2xl gap-3 sm:grid-cols-2"
      >
        <input type="hidden" name="language" value={locale} />
        <input type="hidden" name="_subject" value={t.pro.signup.mailSubject} />
        <div class="hidden" aria-hidden="true">
          <label>Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="flex flex-col gap-1.5 text-left text-xs font-medium text-zinc-400">
          {t.pro.signup.email} *
          <input type="email" name="email" required autocomplete="email" placeholder={t.pro.signup.emailPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-xs font-medium text-zinc-400">
          {t.pro.signup.shop} *
          <input type="text" name="shop" required maxlength="120" autocomplete="organization" placeholder={t.pro.signup.shopPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-xs font-medium text-zinc-400">
          {t.pro.signup.city} *
          <input type="text" name="city" required maxlength="80" autocomplete="address-level2" placeholder={t.pro.signup.cityPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-xs font-medium text-zinc-400">
          {t.pro.signup.phone} ({t.pro.signup.optional})
          <input type="tel" name="phone" maxlength="30" autocomplete="tel" placeholder={t.pro.signup.phonePlaceholder} class={inputClass} />
        </label>
        <div class="sm:col-span-2 mt-2 flex flex-col items-center gap-3">
          <button
            type="submit"
            class="rounded-xl bg-teal-500 px-6 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-teal-400"
          >
            {t.pro.signup.button}
          </button>
          <p class="text-center text-xs text-zinc-500">
            {FORM_ENDPOINT ? t.pro.signup.note : t.pro.signup.noteMailto}
          </p>
        </div>
      </form>
      <p class="mt-6 text-center text-xs text-zinc-500">
        {t.pro.signup.cloudText}{" "}
        <a
          href={CLOUD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-teal-400 underline-offset-2 hover:underline"
          >{t.pro.signup.cloudLink}</a
        >
      </p>
    </div>
  </div>
</section>

<script>
  // Without a form endpoint, build a readable mailto: from the fields instead
  // of the browser's raw text/plain form encoding.
  const form = document.getElementById("beta-signup") as HTMLFormElement | null;
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      if (String(d.get("_gotcha") ?? "")) return;
      const ds = form.dataset;
      const line = (label: string | undefined, key: string) =>
        `${label ?? key}: ${String(d.get(key) ?? "").trim() || "—"}`;
      const body = [
        line(ds.labelEmail, "email"),
        line(ds.labelShop, "shop"),
        line(ds.labelCity, "city"),
        line(ds.labelPhone, "phone"),
        line(ds.labelLanguage, "language"),
      ].join("\n");
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(
        ds.subject ?? "Beta OficinaOS Pro"
      )}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
