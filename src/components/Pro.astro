---
import type { Copy } from "../i18n/pt";
import type { Locale } from "../i18n/utils";
import { CLOUD_URL, CONTACT_EMAIL, DEFAULT_LOCALE, localeUrl } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;

// Beta sign-up form posts to the cloud endpoint; PUBLIC_BETA_FORM_ENDPOINT
// can override it at build time. If the endpoint were ever unset/empty the
// form would fall back to opening an email to CONTACT_EMAIL.
const FORM_ENDPOINT = (
  import.meta.env.PUBLIC_BETA_FORM_ENDPOINT ??
  "https://cloud.oficinaos.app/beta-signup"
).trim();
const MAILTO = `mailto:${CONTACT_EMAIL}`;

// Os 11 módulos em 3 grupos (índices de t.pro.modules), com um só selo «Beta» por secção.
const groupIdx = [
  [0, 1, 2, 10],
  [5, 6, 7, 8],
  [9, 3, 4],
];
const inputClass =
  "h-12 w-full rounded-md border border-border-strong bg-surface px-3 text-md text-text placeholder:text-text-subtle outline-none transition focus:border-focus focus-visible:shadow-[0_0_0_3px_color-mix(in_srgb,var(--oos-color-focus)_28%,transparent)]";
---

<section id="pro" data-product="pro" aria-labelledby="pro-title" class="border-y border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-2xl">
      <p class="flex flex-wrap items-center gap-3 text-sm font-semibold text-product">
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-[3px] bg-product" aria-hidden="true"></span>
          Pro
        </span>
        <span class="rounded-full bg-product-soft px-2.5 py-0.5 text-xs font-semibold text-on-product-soft">{t.pro.badge}</span>
      </p>
      <h2 id="pro-title" class="mt-3 text-[clamp(1.875rem,3.6vw,2.5rem)] leading-[1.1] font-extrabold tracking-[-0.025em] text-balance text-text">
        {t.pro.title}
      </h2>
      <p class="mt-4 text-pretty text-lg text-text-muted">{t.pro.subtitle}</p>
      <p class="mt-4 border-l-2 border-product pl-4 text-text">{t.pro.cloudEngine}</p>
    </div>
    <div class="reveal mt-12 grid gap-px overflow-hidden rounded-xl border border-border bg-border lg:grid-cols-3">
      {
        groupIdx.map((idx, g) => (
          <div class="bg-surface p-5 sm:p-6">
            <h3 class="font-display text-lg font-bold text-text">{t.pro.groups[g]}</h3>
            <ul role="list" class="mt-4 space-y-4">
              {idx.map((i) => {
                const m = t.pro.modules[i];
                return (
                  <li>
                    <a href={localeUrl(locale, m.href)} class="group inline-flex items-center gap-1.5 font-semibold text-text transition-colors hover:text-link">
                      {m.title}
                      <Icon name="arrow" class="h-3.5 w-3.5 text-text-subtle transition-colors group-hover:text-link" />
                    </a>
                    <p class="mt-0.5 text-sm text-text-muted">{m.desc}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-12 rounded-lg border border-border bg-surface shadow-sm p-8"
    >
      <div class="text-center">
        <h3 class="text-xl font-semibold text-text">{t.pro.signup.title}</h3>
        <p class="mx-auto mt-2 max-w-xl text-sm text-text-muted">
          {t.pro.signup.subtitle}
        </p>
      </div>
      <p
        id="beta-signup-result"
        role="status"
        hidden
        class="mx-auto mt-6 max-w-2xl rounded-md px-4 py-3 text-sm font-medium"
      ></p>
      <form
        id="beta-signup"
        action={FORM_ENDPOINT || MAILTO}
        method="POST"
        enctype={FORM_ENDPOINT ? "application/x-www-form-urlencoded" : "text/plain"}
        data-mailto={FORM_ENDPOINT ? undefined : CONTACT_EMAIL}
        data-sending={t.pro.signup.sending}
        data-msg-success={t.pro.signup.success}
        data-msg-invalid={t.pro.signup.errorInvalid}
        data-msg-rate={t.pro.signup.errorRate}
        data-subject={t.pro.signup.mailSubject}
        data-label-email={t.pro.signup.email}
        data-label-shop={t.pro.signup.shop}
        data-label-city={t.pro.signup.city}
        data-label-phone={t.pro.signup.phone}
        data-label-language={t.pro.signup.languageLabel}
        class="mx-auto mt-6 grid max-w-2xl gap-3 sm:grid-cols-2"
      >
        <input type="hidden" name="language" value={locale} />
        <input type="hidden" name="_subject" value={t.pro.signup.mailSubject} />
        <div class="hidden" aria-hidden="true">
          <label>Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="flex flex-col gap-1.5 text-left text-sm font-semibold text-text">
          {t.pro.signup.email} *
          <input type="email" name="email" required autocomplete="email" placeholder={t.pro.signup.emailPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-sm font-semibold text-text">
          {t.pro.signup.shop} *
          <input type="text" name="shop" required maxlength="120" autocomplete="organization" placeholder={t.pro.signup.shopPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-sm font-semibold text-text">
          {t.pro.signup.city} *
          <input type="text" name="city" required maxlength="80" autocomplete="address-level2" placeholder={t.pro.signup.cityPlaceholder} class={inputClass} />
        </label>
        <label class="flex flex-col gap-1.5 text-left text-sm font-semibold text-text">
          {t.pro.signup.phone} ({t.pro.signup.optional})
          <input type="tel" name="phone" maxlength="30" autocomplete="tel" placeholder={t.pro.signup.phonePlaceholder} class={inputClass} />
        </label>
        <div class="sm:col-span-2 mt-2 flex flex-col items-center gap-3">
          <button
            type="submit"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-[18px] text-md font-semibold text-on-primary shadow-sm transition hover:bg-primary-hover"
          >
            {t.pro.signup.button}
          </button>
          <p class="text-center text-xs text-text-muted">
            {FORM_ENDPOINT ? t.pro.signup.note : t.pro.signup.noteMailto}
          </p>
        </div>
      </form>
      <p class="mt-6 text-center text-xs text-text-muted">
        {t.pro.signup.cloudText}{" "}
        <a
          href={CLOUD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-link underline underline-offset-2 hover:text-primary-hover"
          >{t.pro.signup.cloudLink}</a
        >
      </p>
    </div>
  </div>
</section>

<script>
  // Feedback: the cloud redirects back with ?beta=ok|invalid|rate after a
  // native form POST — surface it as an inline banner, then clean the URL.
  const form = document.getElementById("beta-signup") as HTMLFormElement | null;
  const result = document.getElementById("beta-signup-result");
  if (form && result) {
    const msgs: Record<string, string | undefined> = {
      ok: form.dataset.msgSuccess,
      invalid: form.dataset.msgInvalid,
      rate: form.dataset.msgRate,
    };
    const status = new URLSearchParams(location.search).get("beta");
    const msg = status ? msgs[status] : undefined;
    if (status && msg) {
      result.textContent = msg;
      result.classList.toggle("bg-success-soft", status === "ok");
      result.classList.toggle("text-on-success-soft", status === "ok");
      result.classList.toggle("bg-danger-soft", status !== "ok");
      result.classList.toggle("text-on-danger-soft", status !== "ok");
      result.hidden = false;
      const url = new URL(location.href);
      url.searchParams.delete("beta");
      history.replaceState(null, "", url);
    }
    // Loading state while the browser posts to the cloud — mailto mode keeps
    // the button usable since the page never navigates.
    if (!form.dataset.mailto) {
      form.addEventListener("submit", () => {
        if (!form.reportValidity()) return;
        const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
        if (btn && form.dataset.sending) {
          btn.disabled = true;
          btn.textContent = form.dataset.sending;
        }
      });
    }
  }

  // Without a form endpoint, build a readable mailto: from the fields instead
  // of the browser's raw text/plain form encoding.
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      if (String(d.get("_gotcha") ?? "")) return;
      const ds = form.dataset;
      const line = (label: string | undefined, key: string) =>
        `${label ?? key}: ${String(d.get(key) ?? "").trim() || "—"}`;
      const body = [
        line(ds.labelEmail, "email"),
        line(ds.labelShop, "shop"),
        line(ds.labelCity, "city"),
        line(ds.labelPhone, "phone"),
        line(ds.labelLanguage, "language"),
      ].join("\n");
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(
        ds.subject ?? "Beta OficinaOS Pro"
      )}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
