{
  "name": "oficinaos-website",
  "compatibility_date": "2026-02-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (trilingual, noindex) on unmatched paths instead
    // of the generic Cloudflare 404.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // Exigido pelo `wrangler preview` (Workers Builds dispara-o como deploy
  // command nos branches de preview). Vazio: assets/compat ficam no topo.
  "previews": {},
  "routes": [
    { "pattern": "oficinaos.app", "custom_domain": true },
    { "pattern": "www.oficinaos.app", "custom_domain": true }
  ]
}
